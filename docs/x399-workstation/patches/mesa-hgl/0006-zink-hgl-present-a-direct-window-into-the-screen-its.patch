+extern "C" void
+hgl_winsys_scanout_presented(void* contextPrivate, bool presented)
+{
+	if (contextPrivate == NULL)
+		return;
+
+	HGLWinsysContext *context = (HGLWinsysContext*)contextPrivate;
+	context->PresentedIntoScanout(presented);
+}
