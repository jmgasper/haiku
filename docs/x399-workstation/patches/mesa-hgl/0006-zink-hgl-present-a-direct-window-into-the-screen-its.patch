+extern "C" bool
+hgl_winsys_scanout_target(void* contextPrivate,
+	struct hgl_scanout_target* target)
+{
+	if (contextPrivate == NULL)
+		return false;
+
+	HGLWinsysContext *context = (HGLWinsysContext*)contextPrivate;
+	return context->ScanoutTarget(target);
+}
+
