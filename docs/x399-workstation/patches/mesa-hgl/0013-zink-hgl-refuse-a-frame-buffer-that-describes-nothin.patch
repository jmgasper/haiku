From 118c4ea2b4538ed222c291e23c3959f0b3b5f0ab Mon Sep 17 00:00:00 2001
From: jmgasper <jmgasper@gmail.com>
Date: Sat, 19 Sep 2026 03:28:31 +1000
Subject: [PATCH 13/14] zink/hgl: refuse a frame buffer that describes nothing

Switching away from the workspace a window is on and back gives it a
direct buffer description with no address and a row of zero bytes.
Believing it means asking the driver for a frame buffer of that shape on
every frame - throwing away the one in hand, taking a new one, finding
it does not match either - which gets nowhere.

Nothing describes a frame buffer of no width, so that is refused now,
both where the window's placement is read and where the frame buffer is
taken hold of.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 src/gallium/drivers/zink/zink_screen.c          | 4 ++++
 src/gallium/targets/haiku-zink/ZinkRenderer.cpp | 8 ++++++++
 2 files changed, 12 insertions(+)

diff --git a/src/gallium/drivers/zink/zink_screen.c b/src/gallium/drivers/zink/zink_screen.c
index 8a1ffb5..7fca228 100644
--- a/src/gallium/drivers/zink/zink_screen.c
+++ b/src/gallium/drivers/zink/zink_screen.c
@@ -1533,6 +1533,10 @@ acquire_scanout_locked(struct zink_screen *screen,
 {
    const uint32_t bytes_per_row = target->bytes_per_row;
 
+   /* Nothing describes a frame buffer of no width; keep what we have. */
+   if (bytes_per_row == 0 || target->bits == NULL)
+      return false;
+
    if (screen->scanout.buffer != VK_NULL_HANDLE) {
       if (screen->scanout.bits == target->bits &&
           screen->scanout.row_pitch == bytes_per_row)
diff --git a/src/gallium/targets/haiku-zink/ZinkRenderer.cpp b/src/gallium/targets/haiku-zink/ZinkRenderer.cpp
index 4519bfd..2e6b435 100644
--- a/src/gallium/targets/haiku-zink/ZinkRenderer.cpp
+++ b/src/gallium/targets/haiku-zink/ZinkRenderer.cpp
@@ -258,6 +258,14 @@ ZinkRenderer::ScanoutTarget(struct hgl_scanout_target *target)
 	if (fInfo->pixel_format != B_RGB32 && fInfo->pixel_format != B_RGBA32)
 		return false;
 
+	// Switching to another workspace takes the window off the screen, and what
+	// comes back describes no frame buffer at all: no address, and a row of
+	// zero bytes. Believing it means going back to the driver for a frame
+	// buffer of that shape on every frame, which gets nowhere and takes the
+	// program with it.
+	if (fInfo->bits == NULL || fInfo->bytes_per_row == 0)
+		return false;
+
 	// A window that has just moved leaves the strip it came off behind for the
 	// window system to repaint, and a program drawing into the screen at a
 	// thousand frames a second outruns that repaint: the strips linger, one
