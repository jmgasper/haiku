// Compute throughput: a long chain of independent fused multiply-adds.
#version 450

layout(local_size_x = 256) in;

layout(std430, binding = 0) buffer Out { float data[]; };

layout(push_constant) uniform PushConstants { uint iters; } pc;

void main()
{
	uint i = gl_GlobalInvocationID.x;
	// Four independent chains, so the shader is not limited by the latency of
	// a single dependent multiply-add.
	vec4 a = vec4(i, i + 1, i + 2, i + 3);
	vec4 b = vec4(1.0000001);
	vec4 c = vec4(0.0000001);
	vec4 d = a * 0.5;
	vec4 e = a * 0.25;
	vec4 f = a * 0.125;

	for (uint k = 0; k < pc.iters; k++) {
		a = fma(a, b, c);
		d = fma(d, b, c);
		e = fma(e, b, c);
		f = fma(f, b, c);
	}

	data[i] = dot(a, vec4(1.0)) + dot(d, vec4(1.0)) + dot(e, vec4(1.0)) + dot(f, vec4(1.0));
}
