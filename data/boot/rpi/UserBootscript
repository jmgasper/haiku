#!/bin/sh
# The installer remembers completed and declined setup in user settings.
# Closing it without choosing leaves setup available on the next boot.
if [ -x /boot/system/apps/RPiInstaller ]; then
	/boot/system/apps/RPiInstaller --first-boot > /dev/dprintf 2>&1 &
fi

# NTP retries and a saved UTC lower bound for the Pi's missing RTC.
sh "$(finddir B_USER_SETTINGS_DIRECTORY)/boot/rpi-time-sync" \
	> /dev/dprintf 2>&1 &

# Join a remembered Wi-Fi network. net_server only does that by itself after
# a scan someone asked for, and nothing asks for one at start.
[ -x /boot/system/bin/wifiautojoin ] \
	&& /boot/system/bin/wifiautojoin > /dev/dprintf 2>&1 &

# AirTop keeps the auxiliary display (the DSI panel) showing the CPU, the
# network and the temperature; it does nothing where there is no panel.
if [ -x /boot/system/apps/AirTop/AirTop ]; then
	/boot/system/apps/AirTop/AirTop --panel > /dev/dprintf 2>&1 &
fi
