SubDir HAIKU_TOP src add-ons kernel drivers network wlan broadcomfmac host ;

UsePrivateKernelHeaders ;
UsePrivateHeaders drivers ;
UseHeaders [ FDirName $(SUBDIR) $(DOTDOT) ] : true ;

# The SDIO host is plain Haiku kernel code; it is built apart from the
# driver, whose compatibility headers stand in for the system's.
KernelStaticLibrary broadcomfmac_sdio_host.a :
	sdio_host.cpp
	;

# lab driver for the SDIO host alone; in no image
KernelAddon broadcomfmac_probe :
	probe_driver.cpp
	:
	broadcomfmac_sdio_host.a
	;
