SubDir HAIKU_TOP src add-ons kernel drivers misc ;

UsePrivateHeaders drivers ;
UsePrivateKernelHeaders ;

KernelAddon <driver>mem :
	mem.c
	;

KernelAddon <driver>poke :
	poke.cpp
	;

KernelAddon <driver>kdl :
	kdl.c
	;

KernelAddon <driver>test :
	test.c
	;

if $(TARGET_ARCH) = arm64 {
	# lab device for the Raspberry Pi's firmware; in no image
	KernelAddon <driver>rpi_property :
		rpi_property.cpp
		;

	# the VideoCore firmware's services for user programs
	KernelAddon <driver>vchiq :
		vchiq.cpp
		;

	# the BCM2711's HEVC decoder block for the rpi_hevc media add-on
	KernelAddon <driver>rpi_hevc :
		rpi_hevc.cpp
		;
}
