SubDir HAIKU_TOP src add-ons kernel drivers graphics powervr ;

SubDirC++Flags -fno-rtti ;

UsePrivateKernelHeaders ;
UsePrivateHeaders drivers graphics ;
UsePrivateHeaders [ FDirName graphics powervr ] ;

# the display driver's R_TWI controller, for the PMIC
local sunxiDisplay = [ FDirName $(SUBDIR) $(DOTDOT) sunxi_display ] ;
SEARCH_SOURCE += $(sunxiDisplay) ;
SubDirSysHdrs $(sunxiDisplay) ;

# Linux's drm/imagination (upstream/, see upstream/README), compiled as C
# against compat/linux_compat.h, with native replacements in glue/.
local compatDir = [ FDirName $(SUBDIR) compat ] ;
local glueDir = [ FDirName $(SUBDIR) glue ] ;
local upstreamDir = [ FDirName $(SUBDIR) upstream ] ;
SEARCH_SOURCE += $(compatDir) $(glueDir) $(upstreamDir) ;
SubDirSysHdrs $(compatDir) ;
SubDirSysHdrs $(glueDir) ;
SubDirSysHdrs $(upstreamDir) ;

# Linux builds without these: the upstream code does arithmetic on void
# pointers (pvr_device.h), compares mixed signs and passes int* for u32*.
SubDirCcFlags -Wno-pointer-arith -Wno-sign-compare -Wno-pointer-sign ;

KernelAddon powervr :
	A733Power.cpp
	driver.cpp
	PvrDevice.cpp
	twi.cpp

	# compat/
	linux_compat.c
	linux_compat_haiku.cpp

	# glue/
	pvr_haiku_device.c
	pvr_haiku_gem.c
	pvr_haiku_mmu.c
	pvr_haiku_power.c
	pvr_haiku_stubs.c

	# upstream/
	pvr_ccb.c
	pvr_device_info.c
	pvr_dump.c
	pvr_fw.c
	pvr_fw_mips.c
	pvr_fw_startstop.c
	pvr_fw_trace.c
	pvr_fw_util.c
	pvr_vm_mips.c
;
