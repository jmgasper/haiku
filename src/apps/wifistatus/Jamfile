SubDir HAIKU_TOP src apps wifistatus ;

UsePrivateHeaders net ;

UseHeaders [ FDirName $(HAIKU_TOP) src libs compat ] : true ;
UseHeaders [ FDirName $(HAIKU_TOP) src libs compat freebsd_wlan ] : true ;

# The Wi-Fi state machine is shared with the WiFi preferences
SEARCH_SOURCE += [ FDirName $(HAIKU_TOP) src preferences wifi ] ;
SubDirHdrs $(HAIKU_TOP) src preferences wifi ;

Application WiFiStatus :
	WiFiStatus.cpp
	WiFiController.cpp
	: be bnetapi shared [ TargetLibstdc++ ] localestub
	: WiFiStatus.rdef
;

DoCatalogs WiFiStatus :
	x-vnd.Haiku-WiFiStatus
	:
	WiFiStatus.cpp
	WiFiController.cpp
;
