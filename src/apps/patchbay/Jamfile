SubDir HAIKU_TOP src apps patchbay ;

# libmidi.so is only built when the fluidlite softsynth package is
# available (src/kits/midi/Jamfile), and this target links it.
if ! [ FIsBuildFeatureEnabled fluidlite ] {
	return ;
}

Application PatchBay
	:
	PatchApp.cpp
	PatchWin.cpp
	PatchView.cpp
	PatchRow.cpp
	EndpointInfo.cpp
	MidiEventMeter.cpp
	:
	midi midi2 be libicon.a localestub [ TargetLibstdc++ ]
	:
	PatchBay.rdef
;

DoCatalogs PatchBay :
	x-vnd.Haiku.PatchBay
	:
	PatchView.cpp
;
