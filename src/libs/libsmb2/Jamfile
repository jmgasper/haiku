SubDir HAIKU_TOP src libs libsmb2 ;

# libsmb2 6.2, see README.haiku

# for the byte order conversions in <endian.h>
UseHeaders [ FDirName $(HAIKU_TOP) headers compatibility bsd ] : true ;

UseHeaders [ FDirName $(HAIKU_TOP) headers libs libsmb2 ] : true ;
UseHeaders [ FDirName $(HAIKU_TOP) headers libs libsmb2 smb2 ] : true ;

# The library hands errors back as -errno and tells failure from success by
# the sign, which takes error codes that are positive. Whatever links against
# it has to be built the same way and link libposix_error_mapper.a.
SubDirCcFlags -DB_USE_POSITIVE_POSIX_ERRORS ;

# compat.h gives ENOMEM and EINVAL values of its own when it is read before
# anything has defined them, and not every source reads config.h.
SubDirCcFlags -include errno.h ;

SubDirCcFlags -DHAVE_CONFIG_H -D_DEFAULT_SOURCE -Wno-unused -Wno-sign-compare ;

StaticLibrary libsmb2.a :
	aes128ccm.c
	aes.c
	alloc.c
	asn1-ber.c
	compat.c
	dcerpc.c
	dcerpc-lsa.c
	dcerpc-srvsvc.c
	errors.c
	hmac.c
	hmac-md5.c
	init.c
	libsmb2.c
	md4c.c
	md5.c
	ntlmssp.c
	pdu.c
	sha1.c
	sha224-256.c
	sha384-512.c
	smb2-cmd-close.c
	smb2-cmd-create.c
	smb2-cmd-echo.c
	smb2-cmd-error.c
	smb2-cmd-flush.c
	smb2-cmd-ioctl.c
	smb2-cmd-lock.c
	smb2-cmd-logoff.c
	smb2-cmd-negotiate.c
	smb2-cmd-notify-change.c
	smb2-cmd-oplock-break.c
	smb2-cmd-query-directory.c
	smb2-cmd-query-info.c
	smb2-cmd-read.c
	smb2-cmd-session-setup.c
	smb2-cmd-set-info.c
	smb2-cmd-tree-connect.c
	smb2-cmd-tree-disconnect.c
	smb2-cmd-write.c
	smb2-data-file-info.c
	smb2-data-filesystem-info.c
	smb2-data-reparse-point.c
	smb2-data-security-descriptor.c
	smb2-share-enum.c
	smb2-signing.c
	smb3-seal.c
	socket.c
	spnego-wrapper.c
	sync.c
	timestamps.c
	unicode.c
	usha.c
;
