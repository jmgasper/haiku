SubDir HAIKU_TOP src preferences media ;

# libmidi.so is only built when the fluidlite softsynth package is
# available (src/kits/midi/Jamfile), and this target links it.
if ! [ FIsBuildFeatureEnabled fluidlite ] {
	return ;
}

UsePrivateHeaders media midi shared ;

Application Media :
	Media.cpp
	MediaIcons.cpp
	MediaListItem.cpp
	MediaViews.cpp
	MediaWindow.cpp
	MidiSettingsView.cpp
	: media midi be localestub [ TargetLibsupc++ ]
	: media.rdef
	;

DoCatalogs Media
	: x-vnd.Haiku-Media
	: MediaViews.cpp
	  MediaWindow.cpp
	  MidiSettingsView.cpp
;
