--- a/Source/WebKit/PlatformHaiku.cmake
+++ b/Source/WebKit/PlatformHaiku.cmake
@@ -1,5 +1,13 @@
 include(Headers.cmake)
 include(Platform/Curl.cmake)
+
+# Export the native embedding API and process entry points, not WebCore's
+# implementation. On ARM64 this avoids hundreds of thousands of dynamic
+# symbols and their interposable relocations at every application launch.
+if (UNIX AND NOT APPLE)
+    target_link_options(WebKit PRIVATE "LINKER:--version-script,${CMAKE_CURRENT_SOURCE_DIR}/webkit-haiku-symbols.map")
+    set_property(TARGET WebKit APPEND PROPERTY LINK_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/webkit-haiku-symbols.map")
+endif ()
 
 file(MAKE_DIRECTORY ${DERIVED_SOURCES_HAIKU_API_DIR})
 
--- /dev/null
+++ b/Source/WebKit/webkit-haiku-symbols.map
@@ -0,0 +1,13 @@
+# Public C API, native BWebKit classes (including RTTI/vtables), helper
+# process entry points and Haiku ABI identification. Keep the ABI symbols
+# even if no current consumer refers to them by name.
+{
+    global:
+        WK*;
+        _Z*BWebKit*;
+        _ZN6WebKit14WebProcessMainEiPPc;
+        _ZN6WebKit18NetworkProcessMainEiPPc;
+        _gSharedObjectHaikuABI;
+        _gSharedObjectHaikuVersion;
+    local: *;
+};
