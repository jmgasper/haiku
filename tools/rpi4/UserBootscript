#!/bin/sh
# Raspberry Pi lab image: until the board has a network or USB driver there
# is no way to look at a running system, so the system log is copied to the
# FAT boot partition, where the recovery OS can read it after a power cycle.
# Only present in images built with the lab overlay (tools/rpi4/UserBuildConfig).

(
	mkdir -p /boot-fat
	mount -t fat /dev/disk/mmc/0/0/raw /boot-fat 2>/dev/null \
		|| mount -t fat /dev/disk/mmc/0/0 /boot-fat || exit 0

	save() {
		cp /var/log/syslog /boot-fat/syslog.txt
		{
			date
			sysinfo -cpu 2>&1 | head -40
			listdev 2>&1
			ifconfig 2>&1
			ls -l /dev/net /dev/disk /dev/bus /dev/input 2>&1
		} > /boot-fat/state.txt
		sync
	}

	count=0
	while true; do
		save
		count=$((count + 1))
		if [ $count -lt 18 ]; then
			sleep 10
		else
			sleep 60
		fi
	done
) &

# The lab overlay's telnet service (system/settings/network/services) is
# picked up by net_server; say on the serial console where the board is.
(
	sleep 20
	echo RPI4_LAB_STATE_BEGIN
	ifconfig
	ls -l /dev/net
	echo RPI4_LAB_STATE_END
) > /dev/dprintf 2>&1 &
