diff --git a/osal/mpp_allocator.c b/osal/mpp_allocator.c
index afc307f..a957467 100644
--- a/osal/mpp_allocator.c
+++ b/osal/mpp_allocator.c
@@ -17,8 +17,15 @@
 #include "allocator_drm.h"
 #include "allocator_ext_dma.h"
 #include "allocator_dma_heap.h"
+#ifdef __HAIKU__
+#include "allocator_vpu.h"
+#endif
 
+#ifdef __HAIKU__
+#include "linux/drm.h"
+#else
 #include <linux/drm.h>
+#endif
 
 #define MPP_ALLOCATOR_LOCK(p)   pthread_mutex_lock(&(p)->lock);
 #define MPP_ALLOCATOR_UNLOCK(p) pthread_mutex_unlock(&(p)->lock);
@@ -148,25 +155,37 @@ MPP_RET mpp_allocator_get(MppAllocator *allocator, MppAllocatorApi **api,
             p->os_api = allocator_std;
         } break;
         case MPP_BUFFER_TYPE_ION : {
+#ifdef __HAIKU__
+            p->os_api = allocator_vpu;
+#else
             p->os_api = (mpp_rt_allcator_is_valid(MPP_BUFFER_TYPE_DMA_HEAP) != 0) ? allocator_dma_heap :
                         (mpp_rt_allcator_is_valid(MPP_BUFFER_TYPE_ION) != 0) ? allocator_ion :
                         (mpp_rt_allcator_is_valid(MPP_BUFFER_TYPE_DRM) != 0) ? allocator_drm :
                         allocator_std;
+#endif
         } break;
         case MPP_BUFFER_TYPE_EXT_DMA: {
             p->os_api = allocator_ext_dma;
         } break;
         case MPP_BUFFER_TYPE_DRM : {
+#ifdef __HAIKU__
+            p->os_api = allocator_vpu;
+#else
             p->os_api = (mpp_rt_allcator_is_valid(MPP_BUFFER_TYPE_DMA_HEAP) != 0) ? allocator_dma_heap :
                         (mpp_rt_allcator_is_valid(MPP_BUFFER_TYPE_DRM) != 0) ? allocator_drm :
                         (mpp_rt_allcator_is_valid(MPP_BUFFER_TYPE_ION) != 0) ? allocator_ion :
                         allocator_std;
+#endif
         } break;
         case MPP_BUFFER_TYPE_DMA_HEAP: {
+#ifdef __HAIKU__
+            p->os_api = allocator_vpu;
+#else
             p->os_api = (mpp_rt_allcator_is_valid(MPP_BUFFER_TYPE_DMA_HEAP) != 0) ? allocator_dma_heap :
                         (mpp_rt_allcator_is_valid(MPP_BUFFER_TYPE_DRM) != 0) ? allocator_drm :
                         (mpp_rt_allcator_is_valid(MPP_BUFFER_TYPE_ION) != 0) ? allocator_ion :
                         allocator_std;
+#endif
         } break;
         default : {
         } break;
diff --git a/osal/mpp_runtime.c b/osal/mpp_runtime.c
index bca906e..cb8a914 100644
--- a/osal/mpp_runtime.c
+++ b/osal/mpp_runtime.c
@@ -172,11 +172,20 @@ static void mpp_rt_srv_init()
     }
 
     srv->allocator_valid[MPP_BUFFER_TYPE_NORMAL] = 1;
+#ifdef __HAIKU__
+    /* This device admits only validated Rock 5 ITX resources. Its open
+     * permissions currently restrict DMA allocation to root diagnostics. */
+    rk_s32 vpu = open("/dev/video/rk3588_vpu/0", O_RDWR);
+    srv->allocator_valid[MPP_BUFFER_TYPE_DMA_HEAP] = vpu >= 0;
+    if (vpu >= 0)
+        close(vpu);
+#else
     srv->allocator_valid[MPP_BUFFER_TYPE_ION] = !access("/dev/ion", F_OK | R_OK | W_OK);
     srv->allocator_valid[MPP_BUFFER_TYPE_DRM] =
         !access("/dev/dri/renderD128", F_OK | R_OK | W_OK) ||
         !access("/dev/dri/card0", F_OK | R_OK | W_OK);
     srv->allocator_valid[MPP_BUFFER_TYPE_DMA_HEAP] = !access("/dev/dma_heap", F_OK | R_OK);
+#endif
 
     if (!srv->allocator_valid[MPP_BUFFER_TYPE_ION] &&
         !srv->allocator_valid[MPP_BUFFER_TYPE_DRM] &&
diff --git a/osal/mpp_soc.c b/osal/mpp_soc.c
index c146e55..6dcd428 100644
--- a/osal/mpp_soc.c
+++ b/osal/mpp_soc.c
@@ -1119,6 +1119,26 @@ RK_S32 mpp_coding_to_index(MppCodingType coding)
 
 static void read_soc_name(char *name, rk_s32 size)
 {
+#if defined(__HAIKU__)
+    /* This Haiku device is published only after matching the Rock 5 ITX
+     * board and the exact RK3588 VDPU resources in its boot FDT. */
+    struct {
+        rk_u32 version, flags;
+        rk_u64 resources[9];
+        rk_u32 interrupts[2], clocks[2], domain, padding;
+    } resources = {0};
+    _Static_assert(sizeof(resources) == 104, "VPU resource ABI changed");
+    rk_s32 fd = open("/dev/video/rk3588_vpu/0", O_RDONLY);
+    if (fd >= 0) {
+        if (ioctl(fd, 0x52565000, &resources, sizeof(resources)) == 0 &&
+            resources.version == 1 && resources.flags == 1 &&
+            resources.resources[0] == 0xfdb50000) {
+            snprintf(name, size, "radxa,rock-5-itx rockchip,rk3588");
+        }
+        close(fd);
+    }
+    return;
+#else
     const char *path = "/proc/device-tree/compatible";
     char *ptr = NULL;
     rk_s32 fd = open(path, O_RDONLY);
@@ -1145,6 +1165,7 @@ static void read_soc_name(char *name, rk_s32 size)
 
         close(fd);
     }
+#endif
 }
 
 static const MppSocInfo *check_soc_info(const char *soc_name)
diff --git a/osal/mpp_time.c b/osal/mpp_time.c
index e05dc20..fc59d33 100644
--- a/osal/mpp_time.c
+++ b/osal/mpp_time.c
@@ -8,8 +8,10 @@
 #include <time.h>
 #include <errno.h>
 #include <string.h>
+#ifndef __HAIKU__
 #include <sys/timerfd.h>
 #include <sys/epoll.h>
+#endif
 
 #include "mpp_mem.h"
 #include "mpp_time.h"
@@ -213,6 +215,32 @@ MPP_RET check_is_mpp_timer(void *timer)
 
 static void *mpp_timer_thread(void *ctx)
 {
+#ifdef __HAIKU__
+    MppTimerImpl *impl = (MppTimerImpl *)ctx;
+    rk_s32 delay = impl->initial;
+    while (MPP_THREAD_RUNNING == mpp_thread_get_status(impl->thd, THREAD_WORK)) {
+        rk_s64 deadline = mpp_time() + (rk_s64)delay * 1000;
+        while (MPP_THREAD_RUNNING == mpp_thread_get_status(impl->thd, THREAD_WORK)
+               && mpp_time() < deadline) {
+            rk_s64 left = deadline - mpp_time();
+            struct timespec pause = {0, (long)(left > 50000 ? 50000000 : left * 1000)};
+            if (pause.tv_nsec > 0)
+                nanosleep(&pause, NULL);
+        }
+        if (MPP_THREAD_RUNNING != mpp_thread_get_status(impl->thd, THREAD_WORK))
+            break;
+        impl->func(impl->ctx);
+        if (!impl->interval) {
+            while (MPP_THREAD_RUNNING == mpp_thread_get_status(impl->thd, THREAD_WORK)) {
+                struct timespec pause = {0, 50000000};
+                nanosleep(&pause, NULL);
+            }
+            break;
+        }
+        delay = impl->interval;
+    }
+    return NULL;
+#else
     struct itimerspec ts;
     MppTimerImpl *impl = (MppTimerImpl *)ctx;
     MppThread *thd = impl->thd;
@@ -254,10 +282,23 @@ static void *mpp_timer_thread(void *ctx)
     }
 
     return NULL;
+#endif
 }
 
 MppTimer mpp_timer_get(const char *name)
 {
+#ifdef __HAIKU__
+    MppTimerImpl *impl = mpp_calloc(MppTimerImpl, 1);
+    if (!impl)
+        return NULL;
+    impl->timer_fd = -1;
+    impl->epoll_fd = -1;
+    impl->initial = 1000;
+    impl->interval = 1000;
+    impl->check = timer_name;
+    snprintf(impl->name, sizeof(impl->name) - 1, "%s", name);
+    return impl;
+#else
     MppTimerImpl *impl = NULL;
     rk_s32 timer_fd = -1;
     rk_s32 epoll_fd = -1;
@@ -315,6 +356,7 @@ MppTimer mpp_timer_get(const char *name)
     }
 
     return NULL;
+#endif
 }
 
