diff --git a/osal/haiku/allocator_vpu.c b/osal/haiku/allocator_vpu.c
new file mode 100644
index 0000000..ffdafce
--- /dev/null
+++ b/osal/haiku/allocator_vpu.c
@@ -0,0 +1,132 @@
+/* SPDX-License-Identifier: Apache-2.0 OR MIT */
+/* RK3588 VPU buffer adapter for the Haiku diagnostic device. */
+#include <fcntl.h>
+#include <stdint.h>
+#include <sys/ioctl.h>
+#include <unistd.h>
+
+#include "allocator_vpu.h"
+#include "mpp_mem.h"
+
+#define VPU_ALLOC_BUFFER 0x52565008u
+#define VPU_FREE_BUFFER  0x52565009u
+
+typedef struct {
+    uint32_t version;
+    uint32_t handle;
+    uint64_t bytes;
+    int32_t area;
+    uint32_t reserved;
+    uint64_t address;
+} VpuAllocation;
+
+typedef struct {
+    uint32_t version;
+    uint32_t handle;
+} VpuRelease;
+
+_Static_assert(sizeof(VpuAllocation) == 32, "VPU allocation ABI changed");
+
+typedef struct {
+    int fd;
+} VpuAllocator;
+
+static MPP_RET
+vpu_open(void **context, size_t alignment, MppAllocFlagType flags)
+{
+    (void)alignment;
+    (void)flags;
+    if (!context)
+        return MPP_ERR_NULL_PTR;
+    *context = NULL;
+    VpuAllocator *allocator = mpp_calloc(VpuAllocator, 1);
+    if (!allocator)
+        return MPP_ERR_MALLOC;
+    allocator->fd = open("/dev/video/rk3588_vpu/0", O_RDWR);
+    if (allocator->fd < 0) {
+        mpp_free(allocator);
+        return MPP_NOK;
+    }
+    *context = allocator;
+    return MPP_OK;
+}
+
+static MPP_RET
+vpu_close(void *context)
+{
+    VpuAllocator *allocator = (VpuAllocator *)context;
+    if (!allocator)
+        return MPP_ERR_NULL_PTR;
+    close(allocator->fd);
+    mpp_free(allocator);
+    return MPP_OK;
+}
+
+static MPP_RET
+vpu_alloc(void *context, MppBufferInfo *info)
+{
+    VpuAllocator *allocator = (VpuAllocator *)context;
+    if (!allocator || !info || !info->size)
+        return MPP_ERR_NULL_PTR;
+    VpuAllocation request = {0};
+    request.version = 1;
+    request.bytes = info->size;
+    if (ioctl(allocator->fd, VPU_ALLOC_BUFFER, &request, sizeof(request)) != 0)
+        return MPP_NOK;
+    info->fd = (int)request.handle;
+    info->size = request.bytes;
+    info->ptr = (void *)(uintptr_t)request.address;
+    info->hnd = (void *)(intptr_t)request.area;
+    return MPP_OK;
+}
+
+static MPP_RET
+vpu_free(void *context, MppBufferInfo *info)
+{
+    VpuAllocator *allocator = (VpuAllocator *)context;
+    if (!allocator || !info || info->fd <= 0)
+        return MPP_ERR_NULL_PTR;
+    VpuRelease request = {1, (uint32_t)info->fd};
+    if (ioctl(allocator->fd, VPU_FREE_BUFFER, &request, sizeof(request)) != 0)
+        return MPP_NOK;
+    info->fd = -1;
+    info->ptr = NULL;
+    info->hnd = NULL;
+    info->size = 0;
+    return MPP_OK;
+}
+
+static MPP_RET
+vpu_import(void *context, MppBufferInfo *info)
+{
+    (void)context;
+    (void)info;
+    return MPP_NOK;
+}
+
+static MPP_RET
+vpu_mmap(void *context, MppBufferInfo *info)
+{
+    (void)context;
+    return info && info->ptr ? MPP_OK : MPP_NOK;
+}
+
+static MppAllocFlagType
+vpu_flags(void *context)
+{
+    (void)context;
+    return MPP_ALLOC_FLAG_NONE;
+}
+
+os_allocator allocator_vpu = {
+    .type = MPP_BUFFER_TYPE_DMA_HEAP,
+    .name = "haiku-vpu",
+    .open = vpu_open,
+    .close = vpu_close,
+    .alloc = vpu_alloc,
+    .free = vpu_free,
+    .import = vpu_import,
+    .release = vpu_import,
+    .mmap = vpu_mmap,
+    .flags = vpu_flags,
+};
diff --git a/osal/haiku/mpp_dmabuf.c b/osal/haiku/mpp_dmabuf.c
new file mode 100644
index 0000000..04aeb12
--- /dev/null
+++ b/osal/haiku/mpp_dmabuf.c
@@ -0,0 +1,57 @@
+/* SPDX-License-Identifier: Apache-2.0 OR MIT */
+/*
+ * The Haiku VPU buffer API is not implemented yet. Keep cache operations
+ * explicit failures so no caller can submit stale data to the decoder.
+ */
+#include "mpp_dmabuf.h"
+
+MPP_RET
+mpp_dmabuf_sync_begin(RK_S32 fd, RK_S32 ro, const char *caller)
+{
+    (void)fd;
+    (void)ro;
+    (void)caller;
+    return MPP_NOK;
+}
+
+MPP_RET
+mpp_dmabuf_sync_end(RK_S32 fd, RK_S32 ro, const char *caller)
+{
+    (void)fd;
+    (void)ro;
+    (void)caller;
+    return MPP_NOK;
+}
+
+MPP_RET
+mpp_dmabuf_sync_partial_begin(RK_S32 fd, RK_S32 ro, RK_U32 offset,
+                              RK_U32 length, const char *caller)
+{
+    (void)offset;
+    (void)length;
+    return mpp_dmabuf_sync_begin(fd, ro, caller);
+}
+
+MPP_RET
+mpp_dmabuf_sync_partial_end(RK_S32 fd, RK_S32 ro, RK_U32 offset,
+                            RK_U32 length, const char *caller)
+{
+    (void)offset;
+    (void)length;
+    return mpp_dmabuf_sync_end(fd, ro, caller);
+}
+
+MPP_RET
+mpp_dmabuf_set_name(RK_S32 fd, const char *name, const char *caller)
+{
+    (void)fd;
+    (void)name;
+    (void)caller;
+    return MPP_NOK;
+}
+
+RK_U32
+mpp_dmabuf_sync_partial_support(void)
+{
+    return 0;
+}
