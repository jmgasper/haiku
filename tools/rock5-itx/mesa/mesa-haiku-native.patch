+++ b/src/panfrost/lib/kmod/haiku-abi/CsfProperties.h
@@ -0,0 +1,45 @@
+/* Copyright 2026, Haiku, Inc. Distributed under the MIT License. */
+#ifndef MALI_CSF_PROPERTIES_H
+#define MALI_CSF_PROPERTIES_H
+
+#include <stdint.h>
+
+namespace MaliCSF {
+
+static const uint32_t kGetQueueProperties = 0x4d435346;
+static const uint32_t kClientProperties = 32;
+static const uint32_t kQueueReservedRegisters = 4;
+
+// Immutable hardware and validated firmware capabilities, captured by the
+// runtime's hardware worker before it accepts queues. The hardware slot counts
+// are distinct from maxQueues, the driver's total software queue limit. This
+// runtime uses one hardware group/stream at a time. Its wrapper clobbers the
+// last reservedRegisters working registers (currently r92..95).
+struct GpuProperties {
+	uint32_t gpuId, gpuRevision, csfId, coreFeatures;
+	uint32_t l2Features, tilerFeatures, memFeatures, mmuFeatures;
+	uint32_t threadFeatures, maxThreads, maxWorkgroupSize, maxBarrierSize;
+	uint32_t coherencyFeatures, textureFeatures[4], addressSpaces;
+	uint64_t shaderPresent, tilerPresent, l2Present, gpuFeatures;
+	uint32_t firmwareVersion, firmwareFeatures, groupFeatures, streamFeatures;
+	uint32_t groupCount, streamCount, workRegisters, scoreboards;
+	uint32_t reservedRegisters, firmwareTimerHz, maxQueues, maxQueueJobs;
+	uint64_t userVaLimit;
+};
+
+// Requires an owned queue handle. flags and reserved fields must be zero;
+// gpu is output only. Copies cached metadata without MMIO, allocations or
+// queue work, even if that queue has failed. Use QueueInfo for health. Once
+// the handle is retired the query fails. firmwareTimerHz is the frequency
+// used for firmware timeouts, not a GPU timestamp/coherency guarantee.
+struct QueueProperties {
+	uint32_t version, handle, flags, reserved;
+	GpuProperties gpu;
+	uint64_t reserved2[2];
+};
+
+static_assert(sizeof(GpuProperties) == 160, "GPU properties ABI");
+static_assert(sizeof(QueueProperties) == 192, "queue properties ABI");
+
+} // namespace MaliCSF
+#endif
diff --git a/src/panfrost/lib/kmod/haiku-abi/CsfQueue.h b/src/panfrost/lib/kmod/haiku-abi/CsfQueue.h
new file mode 100644
--- /dev/null
+++ b/src/panfrost/lib/kmod/haiku-abi/CsfQueue.h
@@ -0,0 +1,132 @@
+/* Copyright 2026, Haiku, Inc. Distributed under the MIT License. */
+#ifndef MALI_CSF_QUEUE_H
+#define MALI_CSF_QUEUE_H
+
+#include "CsfVm.h"
+#include "CsfHeap.h"
+#include "CsfSync.h"
+#include "CsfProperties.h"
+
+namespace MaliCSF {
+
+static const uint32_t kCreateQueue = 0x4d435340;
+static const uint32_t kDestroyQueue = 0x4d435341;
+static const uint32_t kSubmitQueue = 0x4d435342;
+static const uint32_t kWaitQueue = 0x4d435343;
+static const uint32_t kGetQueueInfo = 0x4d435344;
+static const uint32_t kSubmitQueueSync = 0x4d435345;
+static const uint32_t kGetQueueResetInfo = 0x4d435347;
+static const uint32_t kClientQueues = 4;
+static const uint32_t kMaxRuntimeQueues = 8;
+static const uint32_t kMaxQueueJobs = 64;
+static const uint32_t kMaxStreamBytes = 1024 * 1024;
+static const uint32_t kQueueReady = 1;
+static const uint32_t kQueueRunning = 2;
+static const uint32_t kQueueFailed = 3;
+static const uint32_t kQueueStopping = 4;
+
+static const uint32_t kQueueResetNone = 0;
+static const uint32_t kQueueResetLocalError = 1;
+static const uint32_t kQueueResetPending = 2;
+static const uint32_t kQueueResetQuiescent = 3;
+static const uint32_t kQueueResetUnrecoverable = 4;
+
+// Read-only state for an owned queue. state, error and reserved must be zero
+// on input. Pending means admission has stopped but device cleanup is still
+// running. Quiescent means the failed runtime has finished without retained
+// DMA memory; every affected queue must still close before a new runtime can
+// start. LocalError affects this queue without a global runtime reset.
+struct QueueResetInfo {
+	uint32_t version;
+	uint32_t handle;
+	uint32_t state;
+	int32_t error;
+	uint64_t reserved[2];
+};
+
+// Followed by firmwareBytes bytes for the first queue starting the runtime.
+// An already running runtime accepts firmwareBytes=0. Each queue owns a VM
+// association and preserves command-stream state between submissions.
+struct QueueCreate {
+	uint32_t version;
+	uint32_t flags;
+	uint32_t vm;
+	uint32_t firmwareBytes;
+	uint32_t handle;
+	uint32_t reserved;
+	uint64_t generation;
+	uint64_t reserved2;
+	uint64_t reserved3;
+};
+
+struct QueueHandle {
+	uint32_t version;
+	uint32_t handle;
+	uint64_t reserved;
+};
+
+// The driver captures a VM generation and retains its mappings before enqueue.
+// generation=0 selects current state; nonzero must match. A zero-length stream
+// with address=0 is an ordered completion without application commands.
+struct QueueSubmit {
+	uint32_t version;
+	uint32_t handle;
+	uint64_t generation;
+	uint64_t streamAddress;
+	uint32_t streamBytes;
+	uint32_t flags;
+	uint64_t sequence;
+	uint64_t reserved;
+};
+
+// Followed by waitCount input SyncPoints, then signalCount output SyncPoints.
+// Inputs capture existing fences before outputs are replaced. A missing input
+// fence rejects the whole submission. Outputs signal on completion or cancel.
+struct QueueSubmitSync {
+	QueueSubmit queue;
+	uint32_t waitCount, signalCount;
+	uint64_t reserved;
+};
+
+// timeoutMicros=-1 waits indefinitely, zero polls. An interrupted/timed-out
+// wait leaves the job intact. On success, result contains the job status.
+struct QueueWait {
+	uint32_t version;
+	uint32_t handle;
+	uint64_t sequence;
+	int64_t timeoutMicros;
+	int32_t result;
+	uint32_t flags;
+	uint64_t completed;
+};
+
+struct QueueInfo {
+	uint32_t version;
+	uint32_t handle;
+	uint32_t vm;
+	uint32_t state;
+	int32_t error;
+	uint32_t pending;
+	uint64_t submitted;
+	uint64_t completed;
+	uint64_t activeGeneration;
+	uint64_t insert;
+	uint64_t extract;
+	uint64_t failedSequence;
+	uint32_t interrupts;
+	uint32_t syncEvents;
+	uint32_t suspends;
+	uint32_t resumes;
+	uint64_t reserved;
+};
+
+static_assert(sizeof(QueueCreate) == 48, "queue create ABI");
+static_assert(sizeof(QueueHandle) == 16, "queue handle ABI");
+static_assert(sizeof(QueueSubmit) == 48, "queue submit ABI");
+static_assert(sizeof(QueueSubmitSync) == 64, "synchronized queue submit ABI");
+static_assert(sizeof(QueueWait) == 40, "queue wait ABI");
+static_assert(sizeof(QueueInfo) == 96, "queue info ABI");
+static_assert(sizeof(QueueResetInfo) == 32, "queue reset info ABI");
+
+} // namespace MaliCSF
+#endif
diff --git a/src/panfrost/lib/kmod/haiku-abi/CsfSync.h b/src/panfrost/lib/kmod/haiku-abi/CsfSync.h
new file mode 100644
--- /dev/null
+++ b/src/panfrost/lib/kmod/haiku-abi/CsfSync.h
@@ -0,0 +1,98 @@
+/* Copyright 2026, Haiku, Inc. Distributed under the MIT License. */
+#ifndef MALI_CSF_SYNC_H
+#define MALI_CSF_SYNC_H
+
+#include "CsfBuffer.h"
+
+namespace MaliCSF {
+static const uint32_t kCreateSync = 0x4d435350;
+static const uint32_t kDestroySync = 0x4d435351;
+static const uint32_t kSignalSync = 0x4d435352;
+static const uint32_t kResetSync = 0x4d435353;
+static const uint32_t kWaitSync = 0x4d435354;
+static const uint32_t kGetSyncInfo = 0x4d435355;
+static const uint32_t kExportSync = 0x4d435356;
+static const uint32_t kImportSync = 0x4d435357;
+static const uint32_t kTransferSync = 0x4d435358;
+static const uint32_t kWaitSyncFile = 0x4d435359; // on an exported FD
+static const uint32_t kClientSynchronization = 8;
+static const uint32_t kMaxSyncHandles = 256;
+static const uint32_t kMaxSyncPoints = 64;
+static const uint32_t kSyncInitiallySignaled = 1;
+static const uint32_t kSyncWaitAll = 1;
+static const uint32_t kSyncWaitForSubmit = 2;
+static const uint32_t kSyncWaitAvailable = 4;
+static const uint32_t kSyncSnapshotFd = 1;
+static const uint32_t kSyncAvailable = 1;
+static const uint32_t kSyncSignaled = 2;
+
+struct SyncCreate {
+	uint32_t version, flags, handle, reserved;
+};
+struct SyncHandle {
+	uint32_t version, handle;
+	uint64_t reserved;
+};
+// point=0 selects the current binary fence. Positive timeline insertions must
+// increase; a point between two inserted values selects the next higher value.
+struct SyncPoint {
+	uint32_t handle, flags;
+	uint64_t point;
+};
+// Followed by count SyncPoints. Reset requires point=0. Updates are atomic.
+struct SyncBatch {
+	uint32_t version, count, flags, reserved;
+};
+// Followed by count SyncPoints. Waits capture a fence once available, so reset
+// or replacement cannot redirect an existing wait. timeout=-1 means indefinite.
+// result reports completion/cancellation status; first is the wait-any index.
+struct SyncWait {
+	uint32_t version, flags, count, first;
+	int64_t timeoutMicros;
+	int32_t result;
+	uint32_t reserved;
+};
+struct SyncInfo {
+	uint32_t version, handle;
+	uint64_t submitted, completed;
+	uint32_t flags;
+	int32_t error;
+	uint32_t globalClients, globalObjects, globalPoints, globalEvents;
+	uint32_t globalExports, clientHandles;
+	uint32_t globalWaits, reserved;
+};
+// flags=0 shares the object, including future replacements (point must be 0).
+// Snapshot exports retain just the selected fence. Shared import creates a new
+// handle; snapshot import replaces an existing handle's fence at point.
+// Export requires fd=-1 and publishes a close-on-exec FD atomically. dup/fork
+// retain it. These are native Haiku descriptors, not Linux sync_file FDs.
+struct SyncFd {
+	uint32_t version, handle;
+	int32_t fd;
+	uint32_t flags;
+	uint64_t point, reserved;
+};
+struct SyncTransfer {
+	uint32_t version, flags;
+	SyncPoint source, destination;
+	uint64_t reserved;
+};
+struct SyncFileWait {
+	uint32_t version, flags;
+	uint64_t point;
+	int64_t timeoutMicros;
+	int32_t result;
+	uint32_t reserved;
+};
+
+static_assert(sizeof(SyncCreate) == 16, "sync create ABI");
+static_assert(sizeof(SyncHandle) == 16, "sync handle ABI");
+static_assert(sizeof(SyncPoint) == 16, "sync point ABI");
+static_assert(sizeof(SyncBatch) == 16, "sync batch ABI");
+static_assert(sizeof(SyncWait) == 32, "sync wait ABI");
+static_assert(sizeof(SyncInfo) == 64, "sync info ABI");
+static_assert(sizeof(SyncFd) == 32, "sync fd ABI");
+static_assert(sizeof(SyncTransfer) == 48, "sync transfer ABI");
+static_assert(sizeof(SyncFileWait) == 32, "sync file wait ABI");
+}
+#endif
diff --git a/src/panfrost/lib/kmod/haiku-abi/CsfVm.h b/src/panfrost/lib/kmod/haiku-abi/CsfVm.h
new file mode 100644
--- /dev/null
+++ b/src/panfrost/lib/kmod/haiku-abi/CsfVm.h
@@ -0,0 +1,90 @@
+/* Copyright 2026, Haiku, Inc. Distributed under the MIT License. */
+#ifndef MALI_CSF_VM_H
+#define MALI_CSF_VM_H
+
+#include "CsfBuffer.h"
+
+namespace MaliCSF {
+
+static const uint32_t kCreateVm = 0x4d435320;
+static const uint32_t kDestroyVm = 0x4d435321;
+static const uint32_t kGetVmInfo = 0x4d435322;
+static const uint32_t kBindVm = 0x4d435323;
+static const uint32_t kClientVmMappings = 2;
+static const uint32_t kMaxClientVms = 16;
+static const uint32_t kMaxVmMappings = 256;
+static const uint32_t kMaxVmOperations = 64;
+static const uint32_t kMaxVmTablePages = 1024;
+static const uint64_t kVmUserLimit = UINT64_C(1) << 47;
+static const uint64_t kMaxVmMappedBytes = UINT64_C(1) << 30;
+
+// Match the permission meanings used by Panthor. Read access is implicit;
+// read-only executable, read/write non-executable and read-only non-executable
+// mappings are supported. Writable executable mappings are not supported.
+static const uint32_t kVmReadOnly = 1;
+static const uint32_t kVmNoExecute = 2;
+static const uint32_t kVmUncached = 4;
+static const uint32_t kVmMapOperation = 0;
+static const uint32_t kVmUnmapOperation = 1;
+
+struct VmCreate {
+	uint32_t version;
+	uint32_t flags;
+	uint64_t userLimit; // zero requests the default lower half of the 48-bit VA space
+	uint32_t handle;
+	uint32_t reserved;
+	uint64_t reserved2;
+};
+
+struct VmHandle {
+	uint32_t version;
+	uint32_t handle;
+	uint64_t reserved;
+};
+
+struct VmInfo {
+	uint32_t version;
+	uint32_t handle; // zero queries counts without requiring a live VM handle
+	uint64_t userLimit;
+	uint64_t generation;
+	uint64_t mappedBytes;
+	uint32_t mappings;
+	uint32_t tablePages;
+	uint32_t clientVms;
+	uint32_t globalVms;
+	uint32_t globalGenerations;
+	uint32_t globalTablePages;
+	uint64_t reserved;
+};
+
+// Followed by exactly operationCount VmOperation records. Updates are atomic:
+// validation, allocation or output-copy failure leaves the old generation intact.
+// Map replaces an overlapping range; unmap may split mappings and ignore holes.
+// expectedGeneration=0 accepts the current generation; nonzero is a compare/check.
+struct VmBind {
+	uint32_t version;
+	uint32_t handle;
+	uint32_t operationCount;
+	uint32_t flags;
+	uint64_t expectedGeneration;
+	uint64_t newGeneration;
+};
+
+struct VmOperation {
+	uint32_t type;
+	uint32_t flags;
+	uint64_t address;
+	uint64_t bytes;
+	uint32_t buffer;
+	uint32_t reserved;
+	uint64_t offset;
+};
+
+static_assert(sizeof(VmCreate) == 32, "VM create ABI");
+static_assert(sizeof(VmHandle) == 16, "VM handle ABI");
+static_assert(sizeof(VmInfo) == 64, "VM info ABI");
+static_assert(sizeof(VmBind) == 32, "VM bind ABI");
+static_assert(sizeof(VmOperation) == 40, "VM operation ABI");
+
+} // namespace MaliCSF
+#endif
diff --git a/src/panfrost/lib/kmod/haiku_csf_native.cpp b/src/panfrost/lib/kmod/haiku_csf_native.cpp
new file mode 100644
--- /dev/null
+++ b/src/panfrost/lib/kmod/haiku_csf_native.cpp
@@ -0,0 +1,327 @@
+/* SPDX-License-Identifier: MIT */
+#include "haiku_csf_native.h"
+#include "CsfQueue.h"
+#include "CsfFirmware.h"
+#include <OS.h>
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <sys/stat.h>
+
+using namespace MaliCSF;
+
+static int Fail(int error) { errno = error; return -1; }
+static bool TraceEnabled()
+{
+   const char* value = getenv("HAIKU_CSF_TRACE");
+   return value != NULL && strcmp(value, "1") == 0;
+}
+
+static int NativeIoctl(int fd, uint32_t op, void* request, size_t bytes)
+{
+   int result = ioctl(fd, op, request, bytes);
+   int saved = errno;
+   if (result != 0 && TraceEnabled())
+      fprintf(stderr, "HAIKU_MESA_NATIVE_ERROR op=%08x bytes=%zu result=%d errno=%d\n",
+         op, bytes, result, saved);
+   errno = saved;
+   return result;
+}
+
+template<typename Request>
+static int Call(int fd, uint32_t op, Request& request)
+{
+   return NativeIoctl(fd, op, &request, sizeof(request));
+}
+
+int pan_haiku_check_client(int fd)
+{
+   ClientInfo info{};
+   info.version = kClientVersion;
+   if (Call(fd, kGetClientInfo, info) != 0) return -1;
+   const uint32_t needed = kClientCpuBuffers | kClientVmMappings | kClientQueues
+      | kClientSynchronization | kClientHeaps | kClientProperties;
+   if (info.version != kClientVersion || (info.capabilities & needed) != needed)
+      return Fail(ENOTSUP);
+   return 0;
+}
+
+int pan_haiku_buffer_create(int fd, uint64_t bytes, uint32_t* handle)
+{
+   if (handle == NULL) return Fail(EINVAL);
+   BufferCreate request{kClientVersion, 0, bytes, 0, 0, 0};
+   if (Call(fd, kCreateBuffer, request) != 0) return -1;
+   *handle = request.handle;
+   return 0;
+}
+
+int pan_haiku_buffer_destroy(int fd, uint32_t handle)
+{
+   BufferHandle request{kClientVersion, handle, 0};
+   return Call(fd, kDestroyBuffer, request);
+}
+
+int pan_haiku_buffer_map(int fd, uint32_t handle, pan_haiku_map* map)
+{
+   if (map == NULL) return Fail(EINVAL);
+   BufferMap request{};
+   request.version = kClientVersion;
+   request.handle = handle;
+   if (Call(fd, kMapBuffer, request) != 0) return -1;
+   *map = {reinterpret_cast<void*>(uintptr_t(request.address)), request.bytes,
+      request.area};
+   return 0;
+}
+
+int pan_haiku_buffer_unmap(int32_t area)
+{
+   status_t result = delete_area(area);
+   return result == B_OK ? 0 : Fail(B_TO_POSIX_ERROR(result));
+}
+
+int pan_haiku_vm_create(int fd, uint64_t limit, uint32_t* handle)
+{
+   if (handle == NULL) return Fail(EINVAL);
+   VmCreate request{kClientVersion, 0, limit, 0, 0, 0};
+   if (Call(fd, kCreateVm, request) != 0) return -1;
+   *handle = request.handle;
+   return 0;
+}
+
+int pan_haiku_vm_destroy(int fd, uint32_t handle)
+{
+   VmHandle request{kClientVersion, handle, 0};
+   return Call(fd, kDestroyVm, request);
+}
+
+int pan_haiku_vm_generation(int fd, uint32_t vm, uint64_t* generation)
+{
+   if (generation == NULL) return Fail(EINVAL);
+   VmInfo request{};
+   request.version = kClientVersion;
+   request.handle = vm;
+   if (Call(fd, kGetVmInfo, request) != 0) return -1;
+   *generation = request.generation;
+   return 0;
+}
+
+int pan_haiku_vm_bind(int fd, uint32_t vm, const pan_haiku_vm_op* operations,
+   uint32_t count, uint64_t expectedGeneration, uint64_t* generation)
+{
+   if (count == 0 || count > kMaxVmOperations || operations == NULL)
+      return Fail(EINVAL);
+   struct { VmBind header; VmOperation operations[kMaxVmOperations]; } request{};
+   request.header = {kClientVersion, vm, count, 0, expectedGeneration, 0};
+   for (uint32_t i = 0; i < count; i++) {
+      const pan_haiku_vm_op& op = operations[i];
+      request.operations[i] = {op.type, op.flags, op.address, op.bytes,
+         op.buffer, 0, op.offset};
+   }
+   if (NativeIoctl(fd, kBindVm, &request, sizeof(VmBind) + count * sizeof(VmOperation)) != 0)
+      return -1;
+   if (generation != NULL) *generation = request.header.newGeneration;
+   return 0;
+}
+
+int pan_haiku_queue_create(int fd, uint32_t vm, const void* firmware,
+   size_t bytes, uint32_t* handle)
+{
+   // Use the pinned native parser admission limit before allocating/copying.
+   if (handle == NULL || bytes > kMaxFirmwareBytes
+      || (bytes != 0 && firmware == NULL)) return Fail(EINVAL);
+   QueueCreate* request = static_cast<QueueCreate*>(calloc(1, sizeof(QueueCreate) + bytes));
+   if (request == NULL) return Fail(ENOMEM);
+   request->version = kClientVersion;
+   request->vm = vm;
+   request->firmwareBytes = bytes;
+   if (bytes != 0) memcpy(request + 1, firmware, bytes);
+   int result = NativeIoctl(fd, kCreateQueue, request, sizeof(QueueCreate) + bytes);
+   int error = errno;
+   if (result == 0) *handle = request->handle;
+   free(request);
+   if (result != 0) return Fail(error);
+   return 0;
+}
+
+int pan_haiku_queue_create_with_file(int fd, uint32_t vm,
+   const char* path, uint32_t* handle)
+{
+   if (handle == NULL) return Fail(EINVAL);
+   if (pan_haiku_queue_create(fd, vm, NULL, 0, handle) == 0) return 0;
+   if (errno != ENOENT || path == NULL) return -1;
+   FILE* file = fopen(path, "rb");
+   if (file == NULL) return -1;
+   struct stat info;
+   int error = 0;
+   if (fstat(fileno(file), &info) != 0) error = errno;
+   else if (!S_ISREG(info.st_mode) || info.st_size < 20 || uint64_t(info.st_size) > kMaxFirmwareBytes)
+      error = EINVAL;
+   void* data = NULL;
+   if (error == 0) {
+      data = malloc(size_t(info.st_size));
+      if (data == NULL) error = ENOMEM;
+   }
+   if (error == 0 && (fread(data, 1, info.st_size, file) != size_t(info.st_size)
+      || fgetc(file) != EOF || ferror(file))) error = EIO;
+   if (fclose(file) != 0 && error == 0) error = errno;
+   if (error != 0) {
+      free(data);
+      return Fail(error);
+   }
+   int result = pan_haiku_queue_create(fd, vm, data, info.st_size, handle);
+   error = errno;
+   free(data);
+   // An already-running runtime rejects a nonempty firmware image. Only
+   // this EINVAL case after an ENOENT join permits one fresh join attempt.
+   if (result != 0 && error == EINVAL)
+      return pan_haiku_queue_create(fd, vm, NULL, 0, handle);
+   return result == 0 ? 0 : Fail(error);
+}
+
+int pan_haiku_queue_destroy(int fd, uint32_t handle)
+{
+   if (TraceEnabled()) {
+      int saved = errno;
+      QueueInfo info{};
+      info.version = kClientVersion;
+      info.handle = handle;
+      int result = Call(fd, kGetQueueInfo, info);
+      fprintf(stderr, "HAIKU_MESA_NATIVE_QUEUE handle=%u query=%d state=%u error=%d pending=%u submitted=%llu completed=%llu failed=%llu\n",
+         handle, result, info.state, info.error, info.pending,
+         (unsigned long long)info.submitted, (unsigned long long)info.completed,
+         (unsigned long long)info.failedSequence);
+      errno = saved;
+   }
+   QueueHandle request{kClientVersion, handle, 0};
+   return Call(fd, kDestroyQueue, request);
+}
+
+int pan_haiku_queue_properties(int fd, uint32_t queue, pan_haiku_properties* properties)
+{
+   if (properties == NULL) return Fail(EINVAL);
+   QueueProperties request{};
+   request.version = kClientVersion;
+   request.handle = queue;
+   if (Call(fd, kGetQueueProperties, request) != 0) return -1;
+   const GpuProperties& gpu = request.gpu;
+   if (TraceEnabled()) {
+      int saved = errno;
+      fprintf(stderr, "HAIKU_MESA_NATIVE_GPU handle=%u id=%08x shader=%llx firmware=%08x csf=%08x registers=%u reserved=%u\n",
+         queue, gpu.gpuId, (unsigned long long)gpu.shaderPresent,
+         gpu.firmwareVersion, gpu.csfId, gpu.workRegisters, gpu.reservedRegisters);
+      errno = saved;
+   }
+   pan_haiku_properties result{};
+   result.gpu_id = gpu.gpuId;
+   result.gpu_revision = gpu.gpuRevision;
+   result.core_features = gpu.coreFeatures;
+   result.tiler_features = gpu.tilerFeatures;
+   result.mem_features = gpu.memFeatures;
+   result.mmu_features = gpu.mmuFeatures;
+   for (unsigned i = 0; i < 4; i++) result.texture_features[i] = gpu.textureFeatures[i];
+   result.max_threads = gpu.maxThreads;
+   result.max_workgroup_size = gpu.maxWorkgroupSize;
+   result.thread_features = gpu.threadFeatures;
+   result.shader_present = gpu.shaderPresent;
+   result.tiler_present = gpu.tilerPresent;
+   result.user_va_limit = gpu.userVaLimit;
+   result.group_count = gpu.groupCount;
+   result.stream_count = gpu.streamCount;
+   result.work_registers = gpu.workRegisters;
+   result.scoreboards = gpu.scoreboards;
+   result.reserved_registers = gpu.reservedRegisters;
+   result.max_queues = gpu.maxQueues;
+   result.max_queue_jobs = gpu.maxQueueJobs;
+   *properties = result;
+   return 0;
+}
+
+int pan_haiku_queue_info(int fd, uint32_t queue, pan_haiku_queue_state* state)
+{
+   if (state == NULL) return Fail(EINVAL);
+   QueueInfo request{};
+   request.version = kClientVersion;
+   request.handle = queue;
+   if (Call(fd, kGetQueueInfo, request) != 0) return -1;
+   *state = {request.vm, request.state, request.pending, request.error,
+      request.submitted, request.completed, request.failedSequence};
+   return 0;
+}
+
+static_assert(PAN_HAIKU_RESET_NONE == kQueueResetNone &&
+   PAN_HAIKU_RESET_LOCAL_ERROR == kQueueResetLocalError &&
+   PAN_HAIKU_RESET_PENDING == kQueueResetPending &&
+   PAN_HAIKU_RESET_QUIESCENT == kQueueResetQuiescent &&
+   PAN_HAIKU_RESET_UNRECOVERABLE == kQueueResetUnrecoverable, "native reset states");
+
+int pan_haiku_queue_reset_info(int fd, uint32_t queue, pan_haiku_reset_info* info)
+{
+   if (info == NULL) return Fail(EINVAL);
+   QueueResetInfo request{};
+   request.version = kClientVersion;
+   request.handle = queue;
+   if (Call(fd, kGetQueueResetInfo, request) != 0) return -1;
+   if (request.state > kQueueResetUnrecoverable
+       || (request.state == kQueueResetNone) != (request.error == B_OK))
+      return Fail(EIO);
+   *info = {request.state, request.error};
+   if (TraceEnabled()) {
+      int saved = errno;
+      fprintf(stderr, "HAIKU_MESA_NATIVE_RESET handle=%u state=%u error=%d\n",
+         queue, request.state, request.error);
+      errno = saved;
+   }
+   return 0;
+}
+
+int pan_haiku_queue_submit(int fd, uint32_t queue, uint64_t generation,
+   uint64_t address, uint32_t bytes, const pan_haiku_sync_point* waits,
+   uint32_t waitCount, const pan_haiku_sync_point* signals, uint32_t signalCount,
+   uint64_t* sequence)
+{
+   if (waitCount > kMaxSyncPoints || signalCount > kMaxSyncPoints - waitCount
+      || (waitCount != 0 && waits == NULL) || (signalCount != 0 && signals == NULL))
+      return Fail(EINVAL);
+   struct { QueueSubmitSync header; SyncPoint points[kMaxSyncPoints]; } request{};
+   request.header.queue = {kClientVersion, queue, generation, address, bytes, 0, 0, 0};
+   request.header.waitCount = waitCount;
+   request.header.signalCount = signalCount;
+   for (uint32_t i = 0; i < waitCount; i++)
+      request.points[i] = {waits[i].handle, 0, waits[i].point};
+   for (uint32_t i = 0; i < signalCount; i++)
+      request.points[waitCount + i] = {signals[i].handle, 0, signals[i].point};
+   __sync_synchronize();
+   if (NativeIoctl(fd, kSubmitQueueSync, &request,
+      sizeof(QueueSubmitSync) + (waitCount + signalCount) * sizeof(SyncPoint)) != 0)
+      return -1;
+   if (TraceEnabled()) {
+      int saved = errno;
+      fprintf(stderr, "HAIKU_MESA_NATIVE_SUBMIT handle=%u generation=%llu address=%llx bytes=%u waits=%u signals=%u sequence=%llu\n",
+         queue, (unsigned long long)request.header.queue.generation,
+         (unsigned long long)address, bytes, waitCount, signalCount,
+         (unsigned long long)request.header.queue.sequence);
+      errno = saved;
+   }
+   if (sequence != NULL) *sequence = request.header.queue.sequence;
+   return 0;
+}
+
+int pan_haiku_heap_create(int fd, uint32_t vm, uint32_t chunkSize,
+   uint32_t initialChunks, uint32_t maxChunks, uint32_t targetInFlight,
+   pan_haiku_heap* heap)
+{
+   if (heap == NULL) return Fail(EINVAL);
+   HeapCreate request{kClientVersion, 0, vm, chunkSize,
+      initialChunks, maxChunks, targetInFlight, 0, 0, 0, 0, 0};
+   if (Call(fd, kCreateHeap, request) != 0) return -1;
+   *heap = {request.handle, request.contextAddress, request.firstChunkAddress};
+   return 0;
+}
+
+int pan_haiku_heap_destroy(int fd, uint32_t vm, uint32_t heap)
+{
+   HeapHandle request{kClientVersion, vm, heap, 0, 0, 0};
+   return Call(fd, kDestroyHeap, request);
+}
diff --git a/src/panfrost/lib/kmod/haiku_csf_native.h b/src/panfrost/lib/kmod/haiku_csf_native.h
new file mode 100644
--- /dev/null
+++ b/src/panfrost/lib/kmod/haiku_csf_native.h
@@ -0,0 +1,102 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef PAN_HAIKU_CSF_NATIVE_H
+#define PAN_HAIKU_CSF_NATIVE_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Mesa's process-local bridge to the native Haiku ABI. These C structures
+ * are not ioctl payloads: the C++ implementation explicitly translates them.
+ * All functions return 0, or -1 with errno (which may be negative on Haiku).
+ * Output arguments are changed only on success. No ownership of fd is taken.
+ */
+struct pan_haiku_properties {
+   uint32_t gpu_id, gpu_revision, core_features, tiler_features, mem_features, mmu_features;
+   uint32_t texture_features[4];
+   uint32_t max_threads, max_workgroup_size, thread_features;
+   uint64_t shader_present, tiler_present, user_va_limit;
+   uint32_t group_count, stream_count, work_registers, scoreboards;
+   uint32_t reserved_registers, max_queues, max_queue_jobs;
+};
+
+struct pan_haiku_map {
+   void *address;
+   uint64_t bytes;
+   int32_t area;
+};
+
+/* map=0, unmap=1; flags read-only=1, no-execute=2, uncached=4.
+ * Executable GPU mappings must be read-only. CPU mappings remain RW/NC.
+ */
+struct pan_haiku_vm_op {
+   uint32_t type, flags;
+   uint64_t address, bytes;
+   uint32_t buffer;
+   uint64_t offset;
+};
+
+struct pan_haiku_sync_point { uint32_t handle; uint64_t point; };
+struct pan_haiku_queue_state {
+   uint32_t vm, state, pending;
+   int32_t error;
+   uint64_t submitted, completed, failed_sequence;
+};
+/* Process-local reset states translated from QueueResetInfo. */
+enum pan_haiku_reset_state {
+   PAN_HAIKU_RESET_NONE = 0,
+   PAN_HAIKU_RESET_LOCAL_ERROR = 1,
+   PAN_HAIKU_RESET_PENDING = 2,
+   PAN_HAIKU_RESET_QUIESCENT = 3,
+   PAN_HAIKU_RESET_UNRECOVERABLE = 4,
+};
+struct pan_haiku_reset_info { uint32_t state; int32_t error; };
+struct pan_haiku_heap {
+   uint32_t handle;
+   uint64_t context_address, first_chunk_address;
+};
+
+int pan_haiku_check_client(int fd);
+int pan_haiku_buffer_create(int fd, uint64_t bytes, uint32_t *handle);
+int pan_haiku_buffer_destroy(int fd, uint32_t handle);
+int pan_haiku_buffer_map(int fd, uint32_t handle, struct pan_haiku_map *map);
+int pan_haiku_buffer_unmap(int32_t area);
+int pan_haiku_vm_create(int fd, uint64_t limit, uint32_t *handle);
+int pan_haiku_vm_destroy(int fd, uint32_t handle);
+int pan_haiku_vm_generation(int fd, uint32_t vm, uint64_t *generation);
+int pan_haiku_vm_bind(int fd, uint32_t vm,
+   const struct pan_haiku_vm_op *operations, uint32_t count,
+   uint64_t expected_generation, uint64_t *generation);
+
+/* The first queue supplies the firmware. A running runtime accepts NULL/0.
+ * create_with_file first tries to join, loads a bounded regular file only if
+ * no runtime exists, and retries a join once if another client won that race.
+ */
+int pan_haiku_queue_create(int fd, uint32_t vm, const void *firmware,
+   size_t firmware_bytes, uint32_t *handle);
+int pan_haiku_queue_create_with_file(int fd, uint32_t vm,
+   const char *firmware_path, uint32_t *handle);
+int pan_haiku_queue_destroy(int fd, uint32_t handle);
+int pan_haiku_queue_properties(int fd, uint32_t queue,
+   struct pan_haiku_properties *properties);
+int pan_haiku_queue_info(int fd, uint32_t queue,
+   struct pan_haiku_queue_state *state);
+int pan_haiku_queue_reset_info(int fd, uint32_t queue,
+   struct pan_haiku_reset_info *info);
+int pan_haiku_queue_submit(int fd, uint32_t queue, uint64_t generation,
+   uint64_t address, uint32_t bytes,
+   const struct pan_haiku_sync_point *waits, uint32_t wait_count,
+   const struct pan_haiku_sync_point *signals, uint32_t signal_count,
+   uint64_t *sequence);
+int pan_haiku_heap_create(int fd, uint32_t vm, uint32_t chunk_size,
+   uint32_t initial_chunks, uint32_t max_chunks, uint32_t target_in_flight,
+   struct pan_haiku_heap *heap);
+int pan_haiku_heap_destroy(int fd, uint32_t vm, uint32_t heap);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/src/panfrost/lib/kmod/haiku_csf_sync.cpp b/src/panfrost/lib/kmod/haiku_csf_sync.cpp
new file mode 100644
--- /dev/null
+++ b/src/panfrost/lib/kmod/haiku_csf_sync.cpp
@@ -0,0 +1,120 @@
+/* Copyright 2026, Haiku, Inc. Distributed under the MIT License. */
+#include "haiku_csf_sync.h"
+#include "CsfSync.h"
+#include <OS.h>
+#include <errno.h>
+#include <sys/ioctl.h>
+#include <time.h>
+
+using namespace MaliCSF;
+
+static int Fail(int error) { errno = error; return -1; }
+
+template<typename Request>
+static int Call(int fd, uint32_t op, Request& request)
+{
+   return ioctl(fd, op, &request, sizeof(request));
+}
+
+int pan_haiku_sync_create(int fd, uint32_t flags, uint32_t* handle)
+{
+   if (handle == NULL) return Fail(EINVAL);
+   SyncCreate request{kClientVersion, flags, 0, 0};
+   if (flags == kSyncInitiallySignaled) __sync_synchronize();
+   if (Call(fd, kCreateSync, request) != 0) return -1;
+   *handle = request.handle;
+   return 0;
+}
+
+int pan_haiku_sync_destroy(int fd, uint32_t handle)
+{
+   SyncHandle request{kClientVersion, handle, 0};
+   return Call(fd, kDestroySync, request);
+}
+
+int pan_haiku_sync_update(int fd, const uint32_t* handles,
+   const uint64_t* points, uint32_t count, int reset)
+{
+   if (count == 0 || count > kMaxSyncPoints || handles == NULL
+      || (reset != 0 && reset != 1)) return Fail(EINVAL);
+   struct { SyncBatch header; SyncPoint points[kMaxSyncPoints]; } request{};
+   request.header = {kClientVersion, count, 0, 0};
+   for (unsigned i = 0; i < count; i++)
+      request.points[i] = {handles[i], 0, points != NULL ? points[i] : 0};
+   if (!reset) __sync_synchronize();
+   return ioctl(fd, reset ? kResetSync : kSignalSync, &request,
+      sizeof(SyncBatch) + count * sizeof(SyncPoint));
+}
+
+int pan_haiku_sync_transfer(int fd, uint32_t destination, uint64_t destinationPoint,
+   uint32_t source, uint64_t sourcePoint, uint32_t flags)
+{
+   SyncTransfer request{kClientVersion, flags,
+      {source, 0, sourcePoint}, {destination, 0, destinationPoint}, 0};
+   return Call(fd, kTransferSync, request);
+}
+
+static int RemainingMicros(int64_t deadline, int64_t& result)
+{
+   if (deadline == INT64_MAX) { result = -1; return 0; }
+   if (deadline <= 0) { result = 0; return 0; }
+   timespec now;
+   if (clock_gettime(CLOCK_MONOTONIC, &now) != 0) return -1;
+   if (now.tv_sec < 0 || now.tv_nsec < 0 || now.tv_nsec >= 1000000000)
+      return Fail(EIO);
+   // Avoid overflow even for a clock outside the representable deadline range.
+   if (uint64_t(now.tv_sec) > uint64_t(INT64_MAX) / 1000000000) {
+      result = 0; return 0;
+   }
+   uint64_t time = uint64_t(now.tv_sec) * 1000000000 + uint64_t(now.tv_nsec);
+   if (time >= uint64_t(deadline)) { result = 0; return 0; }
+   uint64_t delta = uint64_t(deadline) - time;
+   result = delta / 1000 + (delta % 1000 != 0);
+   return 0;
+}
+
+int pan_haiku_sync_wait(int fd, const uint32_t* handles, const uint64_t* points,
+   uint32_t count, int64_t deadline, uint32_t flags, uint32_t* first)
+{
+   if (count == 0 || count > kMaxSyncPoints || handles == NULL
+      || (flags & ~(kSyncWaitAll | kSyncWaitForSubmit | kSyncWaitAvailable)) != 0)
+      return Fail(EINVAL);
+   struct { SyncWait header; SyncPoint points[kMaxSyncPoints]; } request{};
+   request.header = {kClientVersion, flags, count, 0, 0, 0, 0};
+   for (unsigned i = 0; i < count; i++)
+      request.points[i] = {handles[i], 0, points != NULL ? points[i] : 0};
+   if (RemainingMicros(deadline, request.header.timeoutMicros) != 0) return -1;
+   if (ioctl(fd, kWaitSync, &request, sizeof(SyncWait) + count * sizeof(SyncPoint)) != 0)
+      return -1;
+   if (request.header.result != B_OK)
+      return Fail(B_TO_POSIX_ERROR(request.header.result));
+   __sync_synchronize();
+   if (first != NULL) *first = request.header.first;
+   return 0;
+}
+
+int pan_haiku_sync_export(int fd, uint32_t handle, uint64_t point,
+   int snapshot, int* exportedFd)
+{
+   if (exportedFd == NULL || (snapshot != 0 && snapshot != 1)) return Fail(EINVAL);
+   SyncFd request{kClientVersion, handle, -1, snapshot ? kSyncSnapshotFd : 0, point, 0};
+   if (Call(fd, kExportSync, request) != 0) return -1;
+   *exportedFd = request.fd;
+   return 0;
+}
+
+int pan_haiku_sync_import(int fd, int sharedFd, uint32_t* handle)
+{
+   if (handle == NULL) return Fail(EINVAL);
+   SyncFd request{kClientVersion, 0, sharedFd, 0, 0, 0};
+   if (Call(fd, kImportSync, request) != 0) return -1;
+   *handle = request.handle;
+   return 0;
+}
+
+int pan_haiku_sync_import_snapshot(int fd, uint32_t handle, uint64_t point,
+   int snapshotFd)
+{
+   SyncFd request{kClientVersion, handle, snapshotFd, kSyncSnapshotFd, point, 0};
+   return Call(fd, kImportSync, request);
+}
diff --git a/src/panfrost/lib/kmod/haiku_csf_sync.h b/src/panfrost/lib/kmod/haiku_csf_sync.h
new file mode 100644
--- /dev/null
+++ b/src/panfrost/lib/kmod/haiku_csf_sync.h
@@ -0,0 +1,47 @@
+/* Copyright 2026, Haiku, Inc. Distributed under the MIT License. */
+#ifndef PAN_HAIKU_CSF_SYNC_H
+#define PAN_HAIKU_CSF_SYNC_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Native Haiku synchronization for the Mesa adapter. Every function returns
+ * zero on success, -1 with errno on failure, including canceled GPU work.
+ * Haiku errno values can be negative: returning -errno would turn failures
+ * into apparent success for Mesa's ret >= 0 checks. No Linux FD ABI is claimed.
+ * Signal publishes prior CPU writes; successful wait orders subsequent reads.
+ * GPU cache maintenance remains the queue runtime's responsibility.
+ */
+int pan_haiku_sync_create(int fd, uint32_t flags, uint32_t *handle);
+int pan_haiku_sync_destroy(int fd, uint32_t handle);
+int pan_haiku_sync_update(int fd, const uint32_t *handles,
+   const uint64_t *points, uint32_t count, int reset);
+int pan_haiku_sync_transfer(int fd, uint32_t destination, uint64_t destination_point,
+   uint32_t source, uint64_t source_point, uint32_t flags);
+
+/* points=NULL selects binary fences. deadline_ns is absolute CLOCK_MONOTONIC
+ * time, INT64_MAX means indefinite, and expired/negative deadlines poll.
+ * Flags: 1 wait-all, 2 wait-for-submit, 4 wait-available. Interruptions are
+ * reported, preserving the caller's deadline and ability to handle signals.
+ */
+int pan_haiku_sync_wait(int fd, const uint32_t *handles, const uint64_t *points,
+   uint32_t count, int64_t deadline_ns, uint32_t flags, uint32_t *first);
+
+/* snapshot=0 exports a shared native object; snapshot=1 exports a fence.
+ * These close-on-exec FDs support the driver's ioctls, not poll or Linux
+ * sync_file operations. Shared import creates a new handle. Snapshot import
+ * replaces the selected fence of an existing handle.
+ */
+int pan_haiku_sync_export(int fd, uint32_t handle, uint64_t point,
+   int snapshot, int *exported_fd);
+int pan_haiku_sync_import(int fd, int shared_fd, uint32_t *handle);
+int pan_haiku_sync_import_snapshot(int fd, uint32_t handle, uint64_t point,
+   int snapshot_fd);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/src/panfrost/lib/kmod/haiku_kmod.c b/src/panfrost/lib/kmod/haiku_kmod.c
new file mode 100644
--- /dev/null
+++ b/src/panfrost/lib/kmod/haiku_kmod.c
@@ -0,0 +1,583 @@
+/*
+ * Copyright © 2023 Collabora, Ltd. (Panfrost synchronization bookkeeping)
+ * SPDX-License-Identifier: MIT
+ *
+ * Native Haiku CSF backend. Panthor structures used by the command builder
+ * are translated in-process; no DRM ioctl or Linux descriptor ABI is exposed.
+ */
+#include <errno.h>
+#include <stdlib.h>
+#include <string.h>
+#include "util/os_time.h"
+#include "util/u_math.h"
+#include "pan_kmod_backend.h"
+#include "haiku_csf_native.h"
+#include "haiku_csf_sync.h"
+#include "haiku_kmod.h"
+
+#define HAIKU_MAX_MAPPINGS 256
+#define HAIKU_MAX_GROUPS 8
+#define HAIKU_MAX_HEAPS 128
+
+struct haiku_range { uint64_t start, size; };
+struct haiku_vm {
+   struct pan_kmod_vm base;
+   simple_mtx_t map_lock, sync_lock;
+   uint64_t start, limit;
+   struct haiku_range mappings[HAIKU_MAX_MAPPINGS];
+   unsigned count;
+   uint32_t sync_handle;
+   uint64_t sync_point;
+};
+struct haiku_bo {
+   struct pan_kmod_bo base;
+   simple_mtx_t lock;
+   struct pan_haiku_map map;
+   uint32_t sync_handle;
+   uint64_t read_point, write_point;
+};
+struct haiku_object { uint32_t handle, vm; };
+struct haiku_dev {
+   struct pan_kmod_dev base;
+   struct pan_haiku_properties props;
+   struct drm_panthor_csif_info csif;
+   uint32_t bootstrap_vm, bootstrap_queue;
+   simple_mtx_t lock;
+   struct haiku_object groups[HAIKU_MAX_GROUPS], heaps[HAIKU_MAX_HEAPS];
+};
+
+const struct pan_kmod_ops haiku_kmod_ops;
+
+static int fail(int error) { errno = error; return -1; }
+static void log_failure(const char *operation, int result)
+{
+   if (result) mesa_loge("Haiku CSF %s failed (errno=%d)", operation, errno);
+}
+
+struct pan_kmod_dev *
+haiku_kmod_dev_create(int fd, uint32_t flags,
+                     const struct pan_kmod_allocator *allocator)
+{
+   if (flags & ~PAN_KMOD_DEV_FLAG_OWNS_FD) {
+      errno = EINVAL;
+      return NULL;
+   }
+   if (pan_haiku_check_client(fd)) return NULL;
+   struct haiku_dev *dev = pan_kmod_alloc(allocator, sizeof(*dev));
+   if (!dev) { errno = ENOMEM; return NULL; }
+   if (pan_haiku_vm_create(fd, 0, &dev->bootstrap_vm)) goto fail_free;
+   const char *firmware = getenv("HAIKU_CSF_FIRMWARE");
+   if (!firmware) firmware = "/boot/system/data/firmware/mali/arch10.8/mali_csffw.bin";
+   if (pan_haiku_queue_create_with_file(fd, dev->bootstrap_vm, firmware,
+                                      &dev->bootstrap_queue)) goto fail_vm;
+   if (pan_haiku_queue_properties(fd, dev->bootstrap_queue, &dev->props)) goto fail_queue;
+   /* This backend currently targets the native arch10 runtime. Refuse other
+    * architectures instead of entering one of Mesa's DRM-only JM paths.
+    */
+   if ((dev->props.gpu_id >> 28) != 10 || !dev->props.shader_present
+       || !dev->props.tiler_present || dev->props.work_registers < 96
+       || dev->props.reserved_registers > 4 || dev->props.scoreboards < 8
+       || !dev->props.max_threads || !dev->props.max_workgroup_size
+       || !(dev->props.thread_features >> 24)
+       || !(dev->props.thread_features & 0x3fffff)) {
+      errno = ENOTSUP;
+      goto fail_queue;
+   }
+   dev->csif = (struct drm_panthor_csif_info) {
+      .csg_slot_count = dev->props.group_count,
+      .cs_slot_count = dev->props.stream_count,
+      .cs_reg_count = dev->props.work_registers,
+      .scoreboard_slot_count = dev->props.scoreboards,
+      .unpreserved_cs_reg_count = dev->props.reserved_registers,
+   };
+   simple_mtx_init(&dev->lock, mtx_plain);
+   /* No fabricated DRM version. Capabilities come from the native query. */
+   pan_kmod_dev_init(&dev->base, fd, flags, NULL, &haiku_kmod_ops, allocator);
+   return &dev->base;
+fail_queue: {
+   int error = errno;
+   log_failure("bootstrap queue destroy", pan_haiku_queue_destroy(fd, dev->bootstrap_queue));
+   errno = error;
+}
+fail_vm: {
+   int error = errno;
+   log_failure("bootstrap VM destroy", pan_haiku_vm_destroy(fd, dev->bootstrap_vm));
+   errno = error;
+}
+fail_free:
+   pan_kmod_free(allocator, dev);
+   return NULL;
+}
+
+static void haiku_dev_destroy(struct pan_kmod_dev *base)
+{
+   struct haiku_dev *dev = container_of(base, struct haiku_dev, base);
+   /* Normally context cleanup already retired these objects. Keep cleanup
+    * complete after a partially failed context initialization, too.
+    */
+   for (unsigned i = 0; i < HAIKU_MAX_GROUPS; i++)
+      if (dev->groups[i].handle)
+         log_failure("queue destroy", pan_haiku_queue_destroy(base->fd, dev->groups[i].handle));
+   for (unsigned i = 0; i < HAIKU_MAX_HEAPS; i++)
+      if (dev->heaps[i].handle)
+         log_failure("heap destroy", pan_haiku_heap_destroy(base->fd, dev->heaps[i].vm,
+                                                          dev->heaps[i].handle));
+   log_failure("bootstrap queue destroy", pan_haiku_queue_destroy(base->fd, dev->bootstrap_queue));
+   log_failure("bootstrap VM destroy", pan_haiku_vm_destroy(base->fd, dev->bootstrap_vm));
+   simple_mtx_destroy(&dev->lock);
+   pan_kmod_dev_cleanup(base);
+   pan_kmod_free(base->allocator, dev);
+}
+
+static void haiku_dev_props(const struct pan_kmod_dev *base,
+                            struct pan_kmod_dev_props *out)
+{
+   const struct haiku_dev *dev = container_of(base, struct haiku_dev, base);
+   const struct pan_haiku_properties *p = &dev->props;
+   *out = (struct pan_kmod_dev_props) {
+      .gpu_id = p->gpu_id, .gpu_variant = p->core_features & 0xff,
+      .shader_present = p->shader_present, .tiler_features = p->tiler_features,
+      .mem_features = p->mem_features, .mmu_features = p->mmu_features,
+      .max_threads_per_core = p->max_threads,
+      .max_threads_per_wg = p->max_workgroup_size,
+      .max_tasks_per_core = p->thread_features >> 24,
+      .num_registers_per_core = p->thread_features & 0x3fffff,
+      .max_tls_instance_per_core = p->max_threads,
+      .allowed_group_priorities_mask = PAN_KMOD_GROUP_ALLOW_PRIORITY_MEDIUM,
+      /* GPU timestamps and coherent propagation are not native capabilities. */
+   };
+   memcpy(out->texture_features, p->texture_features, sizeof(out->texture_features));
+}
+
+static struct pan_kmod_va_range haiku_dev_va(const struct pan_kmod_dev *base)
+{
+   const struct haiku_dev *dev = container_of(base, struct haiku_dev, base);
+   return (struct pan_kmod_va_range) { .start = 0, .size = dev->props.user_va_limit };
+}
+
+static struct pan_kmod_bo *haiku_bo_alloc(struct pan_kmod_dev *dev,
+   struct pan_kmod_vm *exclusive_vm, uint64_t size, uint32_t flags)
+{
+   const uint32_t supported = PAN_KMOD_BO_FLAG_EXECUTABLE | PAN_KMOD_BO_FLAG_NO_MMAP
+      | PAN_KMOD_BO_FLAG_GPU_UNCACHED;
+   if (flags & ~supported || !size || (size & 4095)
+       || (exclusive_vm && exclusive_vm->dev != dev)) {
+      errno = EINVAL;
+      return NULL;
+   }
+   struct haiku_bo *bo = pan_kmod_dev_alloc(dev, sizeof(*bo));
+   if (!bo) { errno = ENOMEM; return NULL; }
+   bo->map.area = -1;
+   uint32_t handle;
+   if (pan_haiku_buffer_create(dev->fd, size, &handle)) goto fail;
+   if (exclusive_vm)
+      bo->sync_handle = container_of(exclusive_vm, struct haiku_vm, base)->sync_handle;
+   else if (pan_haiku_sync_create(dev->fd, 1, &bo->sync_handle)) {
+      int error = errno;
+      log_failure("buffer destroy", pan_haiku_buffer_destroy(dev->fd, handle));
+      errno = error;
+      goto fail;
+   }
+   simple_mtx_init(&bo->lock, mtx_plain);
+   pan_kmod_bo_init(&bo->base, dev, exclusive_vm, size, flags, handle);
+   return &bo->base;
+fail:
+   pan_kmod_dev_free(dev, bo);
+   return NULL;
+}
+
+static void haiku_bo_free(struct pan_kmod_bo *base)
+{
+   struct haiku_bo *bo = container_of(base, struct haiku_bo, base);
+   if (bo->map.area >= 0)
+      log_failure("area delete", pan_haiku_buffer_unmap(bo->map.area));
+   if (!base->exclusive_vm)
+      log_failure("BO sync destroy", pan_haiku_sync_destroy(base->dev->fd, bo->sync_handle));
+   log_failure("buffer destroy", pan_haiku_buffer_destroy(base->dev->fd, base->handle));
+   simple_mtx_destroy(&bo->lock);
+   pan_kmod_dev_free(base->dev, bo);
+}
+
+void *haiku_kmod_bo_mmap(struct pan_kmod_bo *base, off_t offset, size_t size,
+                        int prot, int flags, void *address)
+{
+   if (offset != 0 || size != base->size || address || prot != (PROT_READ | PROT_WRITE)
+       || flags != MAP_SHARED || (base->flags & PAN_KMOD_BO_FLAG_NO_MMAP)) {
+      errno = ENOTSUP;
+      return MAP_FAILED;
+   }
+   struct haiku_bo *bo = container_of(base, struct haiku_bo, base);
+   simple_mtx_lock(&bo->lock);
+   int ret = bo->map.area >= 0 ? fail(EBUSY)
+      : pan_haiku_buffer_map(base->dev->fd, base->handle, &bo->map);
+   void *result = ret ? MAP_FAILED : bo->map.address;
+   simple_mtx_unlock(&bo->lock);
+   return result;
+}
+
+int haiku_kmod_bo_munmap(struct pan_kmod_bo *base, void *address, size_t size)
+{
+   struct haiku_bo *bo = container_of(base, struct haiku_bo, base);
+   simple_mtx_lock(&bo->lock);
+   int ret = address != bo->map.address || size != bo->map.bytes || bo->map.area < 0
+      ? fail(EINVAL) : pan_haiku_buffer_unmap(bo->map.area);
+   if (!ret) bo->map = (struct pan_haiku_map) { .area = -1 };
+   simple_mtx_unlock(&bo->lock);
+   return ret;
+}
+
+static bool haiku_bo_wait(struct pan_kmod_bo *base, int64_t timeout, bool read_only)
+{
+   struct haiku_bo *bo = container_of(base, struct haiku_bo, base);
+   simple_mtx_lock(&bo->lock);
+   uint64_t point = read_only ? bo->write_point : MAX2(bo->read_point, bo->write_point);
+   simple_mtx_unlock(&bo->lock);
+   if (!point) return true;
+   int64_t now = os_time_get_nano();
+   int64_t deadline = timeout < 0 || timeout >= INT64_MAX - now
+      ? INT64_MAX : now + timeout;
+   return pan_haiku_sync_wait(base->dev->fd, &bo->sync_handle, &point, 1,
+                             deadline, 1, NULL) == 0;
+}
+
+static struct pan_kmod_vm *haiku_vm_create(struct pan_kmod_dev *dev, uint32_t flags,
+                                          uint64_t start, uint64_t range)
+{
+   /* This first backend implements Gallium's auto-VA, activity-tracked VM.
+    * Explicit asynchronous binds (used by Vulkan) are rejected below.
+    */
+   if (flags != (PAN_KMOD_VM_FLAG_AUTO_VA | PAN_KMOD_VM_FLAG_TRACK_ACTIVITY)
+       || !start || !range || ((start | range) & 4095)
+       || start > UINT64_MAX - range || start + range > haiku_dev_va(dev).size) {
+      errno = ENOTSUP;
+      return NULL;
+   }
+   struct haiku_vm *vm = pan_kmod_dev_alloc(dev, sizeof(*vm));
+   if (!vm) { errno = ENOMEM; return NULL; }
+   uint32_t handle;
+   if (pan_haiku_vm_create(dev->fd, start + range, &handle)) goto fail;
+   if (pan_haiku_sync_create(dev->fd, 1, &vm->sync_handle)) {
+      int error = errno;
+      log_failure("VM destroy", pan_haiku_vm_destroy(dev->fd, handle));
+      errno = error;
+      goto fail;
+   }
+   simple_mtx_init(&vm->map_lock, mtx_plain);
+   simple_mtx_init(&vm->sync_lock, mtx_plain);
+   vm->start = start;
+   vm->limit = start + range;
+   pan_kmod_vm_init(&vm->base, dev, handle, flags, PAN_PGSIZE_4K);
+   return &vm->base;
+fail:
+   pan_kmod_dev_free(dev, vm);
+   return NULL;
+}
+
+static void haiku_vm_destroy(struct pan_kmod_vm *base)
+{
+   struct haiku_vm *vm = container_of(base, struct haiku_vm, base);
+   log_failure("VM destroy", pan_haiku_vm_destroy(base->dev->fd, base->handle));
+   log_failure("VM sync destroy", pan_haiku_sync_destroy(base->dev->fd, vm->sync_handle));
+   simple_mtx_destroy(&vm->map_lock);
+   simple_mtx_destroy(&vm->sync_lock);
+   pan_kmod_dev_free(base->dev, vm);
+}
+
+static int haiku_vm_bind(struct pan_kmod_vm *base, enum pan_kmod_vm_op_mode mode,
+                         struct pan_kmod_vm_op *ops, uint32_t count)
+{
+   if (mode != PAN_KMOD_VM_OP_MODE_IMMEDIATE
+       && mode != PAN_KMOD_VM_OP_MODE_DEFER_TO_NEXT_IDLE_POINT) return fail(ENOTSUP);
+   if (!count || count > 64 || !ops) return fail(EINVAL);
+   struct haiku_vm *vm = container_of(base, struct haiku_vm, base);
+   struct haiku_range next[HAIKU_MAX_MAPPINGS];
+   struct pan_haiku_vm_op native[64] = {0};
+   uint64_t output_va[64];
+   simple_mtx_lock(&vm->map_lock);
+   unsigned next_count = vm->count;
+   memcpy(next, vm->mappings, next_count * sizeof(*next));
+   int ret = -1;
+   for (unsigned i = 0; i < count; i++) {
+      const struct pan_kmod_vm_op *op = &ops[i];
+      if (op->syncs.count || !op->va.size || (op->va.size & 4095)) {
+         errno = EINVAL; goto out;
+      }
+      if (op->type == PAN_KMOD_VM_OP_TYPE_MAP) {
+         if (op->va.start != PAN_KMOD_VM_MAP_AUTO_VA || !op->map.bo
+             || op->map.bo->dev != base->dev || (op->map.bo->exclusive_vm
+                && op->map.bo->exclusive_vm != base)
+             || op->map.bo_offset < 0 || (op->map.bo_offset & 4095)
+             || (uint64_t)op->map.bo_offset > op->map.bo->size
+             || op->va.size > op->map.bo->size - (uint64_t)op->map.bo_offset) {
+            errno = EINVAL; goto out;
+         }
+         if (next_count == HAIKU_MAX_MAPPINGS) { errno = ENOSPC; goto out; }
+         uint64_t address = vm->start;
+         /* Search the sorted live intervals; no allocations after commit. */
+         unsigned slot = 0;
+         for (; slot < next_count; slot++) {
+            if (op->va.size <= next[slot].start - address) break;
+            address = next[slot].start + next[slot].size;
+         }
+         if (address > vm->limit || op->va.size > vm->limit - address) {
+            errno = ENOSPC; goto out;
+         }
+         memmove(next + slot + 1, next + slot, (next_count - slot) * sizeof(*next));
+         next[slot] = (struct haiku_range) { address, op->va.size };
+         next_count++;
+         native[i] = (struct pan_haiku_vm_op) {
+            .type = 0, .flags = op->map.bo->flags & PAN_KMOD_BO_FLAG_EXECUTABLE ? 1 : 2,
+            .address = address, .bytes = op->va.size, .buffer = op->map.bo->handle,
+            .offset = op->map.bo_offset,
+         };
+         if (op->map.bo->flags & PAN_KMOD_BO_FLAG_GPU_UNCACHED) native[i].flags |= 4;
+         output_va[i] = address;
+      } else if (op->type == PAN_KMOD_VM_OP_TYPE_UNMAP) {
+         unsigned slot = 0;
+         for (; slot < next_count; slot++)
+            if (next[slot].start == op->va.start && next[slot].size == op->va.size) break;
+         /* Auto-VA clients free exactly the range they allocated. Reject
+          * partial/double free rather than corrupting the local VA allocator.
+          */
+         if (slot == next_count) { errno = EINVAL; goto out; }
+         memmove(next + slot, next + slot + 1, (next_count - slot - 1) * sizeof(*next));
+         next_count--;
+         native[i] = (struct pan_haiku_vm_op) { .type = 1,
+            .address = op->va.start, .bytes = op->va.size };
+         output_va[i] = op->va.start;
+      } else { errno = ENOTSUP; goto out; }
+   }
+   /* The kernel captures an immutable VM generation for every submission.
+    * Retired mappings survive until all jobs that captured them complete.
+    * Thus publishing the new generation is a safe deferred unmap even when
+    * old jobs are pending, including immediate reuse of the same GPU VA.
+    * Failed native transactions leave both kernel and local ranges intact.
+    */
+   ret = pan_haiku_vm_bind(base->dev->fd, base->handle, native, count, 0, NULL);
+   if (!ret) {
+      memcpy(vm->mappings, next, next_count * sizeof(*next));
+      vm->count = next_count;
+      for (unsigned i = 0; i < count; i++) ops[i].va.start = output_va[i];
+   }
+out:
+   simple_mtx_unlock(&vm->map_lock);
+   return ret;
+}
+
+static enum pan_kmod_vm_state haiku_vm_state(struct pan_kmod_vm *base)
+{
+   struct haiku_dev *dev = container_of(base->dev, struct haiku_dev, base);
+   struct pan_haiku_queue_state state;
+   /* The qualified kernel retains a failed runtime until recovery. A dead
+    * runtime cannot be repaired by recreating a Gallium context or VM.
+    */
+   if (pan_haiku_queue_info(base->dev->fd, dev->bootstrap_queue, &state)
+       || (state.state != 1 && state.state != 2)) return PAN_KMOD_VM_FAULTY;
+   uint64_t generation;
+   return pan_haiku_vm_generation(base->dev->fd, base->handle, &generation)
+      ? PAN_KMOD_VM_FAULTY : PAN_KMOD_VM_USABLE;
+}
+
+int haiku_kmod_bo_attach_sync_point(struct pan_kmod_bo *base, uint32_t handle,
+                                   uint64_t point, bool written)
+{
+   struct haiku_bo *bo = container_of(base, struct haiku_bo, base);
+   simple_mtx_lock(&bo->lock);
+   int ret = 0;
+   if (base->exclusive_vm) {
+      if (handle != bo->sync_handle) ret = fail(EINVAL);
+      else {
+         bo->read_point = MAX2(bo->read_point, point);
+         if (written) bo->write_point = MAX2(bo->write_point, point);
+      }
+   } else {
+      uint64_t prior = MAX2(bo->read_point, bo->write_point);
+      if (prior == UINT64_MAX) ret = fail(EOVERFLOW);
+      else {
+         uint64_t next = prior + 1;
+         ret = pan_haiku_sync_transfer(base->dev->fd, bo->sync_handle, next,
+                                      handle, point, 0);
+         if (!ret) {
+            bo->read_point = next;
+            if (written) bo->write_point = next;
+         }
+      }
+   }
+   simple_mtx_unlock(&bo->lock);
+   return ret;
+}
+
+int haiku_kmod_bo_get_sync_point(struct pan_kmod_bo *base, uint32_t *handle,
+                                uint64_t *point, bool read_only)
+{
+   if (!handle || !point) return fail(EINVAL);
+   struct haiku_bo *bo = container_of(base, struct haiku_bo, base);
+   simple_mtx_lock(&bo->lock);
+   *handle = bo->sync_handle;
+   *point = read_only ? bo->write_point : MAX2(bo->read_point, bo->write_point);
+   simple_mtx_unlock(&bo->lock);
+   return 0;
+}
+
+uint32_t haiku_kmod_vm_sync_handle(struct pan_kmod_vm *base)
+{
+   return container_of(base, struct haiku_vm, base)->sync_handle;
+}
+uint64_t haiku_kmod_vm_sync_lock(struct pan_kmod_vm *base)
+{
+   struct haiku_vm *vm = container_of(base, struct haiku_vm, base);
+   simple_mtx_lock(&vm->sync_lock);
+   return vm->sync_point;
+}
+void haiku_kmod_vm_sync_unlock(struct pan_kmod_vm *base, uint64_t point)
+{
+   struct haiku_vm *vm = container_of(base, struct haiku_vm, base);
+   assert(point >= vm->sync_point);
+   vm->sync_point = point;
+   simple_mtx_unlock(&vm->sync_lock);
+}
+uint32_t haiku_kmod_get_flush_id(const struct pan_kmod_dev *dev)
+{
+   (void)dev;
+   /* Panthor UAPI documents zero as an unconditional flush. Haiku's queue
+    * wrapper already executes that flush before calling the user stream.
+    */
+   return 0;
+}
+const struct drm_panthor_csif_info *haiku_kmod_get_csif_props(const struct pan_kmod_dev *base)
+{
+   return &container_of(base, struct haiku_dev, base)->csif;
+}
+
+static struct haiku_object *find_object(struct haiku_object *objects, unsigned count,
+                                       uint32_t handle)
+{
+   for (unsigned i = 0; i < count; i++) if (objects[i].handle == handle) return &objects[i];
+   return NULL;
+}
+
+int haiku_kmod_group_create(struct pan_kmod_dev *base, struct drm_panthor_group_create *req)
+{
+   struct haiku_dev *dev = container_of(base, struct haiku_dev, base);
+   if (req->queues.count != 1 || req->queues.stride != sizeof(struct drm_panthor_queue_create)
+       || !req->queues.array || req->pad || req->group_handle
+       || req->priority != PANTHOR_GROUP_PRIORITY_MEDIUM
+       || req->compute_core_mask != dev->props.shader_present
+       || req->fragment_core_mask != dev->props.shader_present
+       || req->tiler_core_mask != dev->props.tiler_present
+       || req->max_compute_cores != util_bitcount64(dev->props.shader_present)
+       || req->max_fragment_cores != util_bitcount64(dev->props.shader_present)
+       || req->max_tiler_cores != util_bitcount64(dev->props.tiler_present)) return fail(ENOTSUP);
+   const struct drm_panthor_queue_create *queue = (const void *)(uintptr_t)req->queues.array;
+   if (queue->priority != 1 || queue->ringbuf_size != 65536
+       || queue->pad[0] || queue->pad[1] || queue->pad[2]) return fail(ENOTSUP);
+   simple_mtx_lock(&dev->lock);
+   struct haiku_object *slot = find_object(dev->groups, HAIKU_MAX_GROUPS, 0);
+   uint32_t handle;
+   int ret = slot ? pan_haiku_queue_create(base->fd, req->vm_id, NULL, 0, &handle) : fail(ENOSPC);
+   if (!ret) {
+      *slot = (struct haiku_object) { handle, req->vm_id };
+      req->group_handle = handle;
+   }
+   simple_mtx_unlock(&dev->lock);
+   return ret;
+}
+int haiku_kmod_group_destroy(struct pan_kmod_dev *base, struct drm_panthor_group_destroy *req)
+{
+   struct haiku_dev *dev = container_of(base, struct haiku_dev, base);
+   if (!req->group_handle || req->pad) return fail(EINVAL);
+   simple_mtx_lock(&dev->lock);
+   struct haiku_object *slot = find_object(dev->groups, HAIKU_MAX_GROUPS, req->group_handle);
+   int ret = slot ? pan_haiku_queue_destroy(base->fd, slot->handle) : fail(EINVAL);
+   if (!ret) memset(slot, 0, sizeof(*slot));
+   simple_mtx_unlock(&dev->lock);
+   return ret;
+}
+
+int haiku_kmod_group_submit(struct pan_kmod_dev *base, struct drm_panthor_group_submit *req)
+{
+   if (!req->group_handle || req->pad || req->queue_submits.count != 1
+       || req->queue_submits.stride != sizeof(struct drm_panthor_queue_submit)
+       || !req->queue_submits.array) return fail(ENOTSUP);
+   const struct drm_panthor_queue_submit *q = (const void *)(uintptr_t)req->queue_submits.array;
+   if (q->queue_index || q->pad || q->latest_flush
+       || q->syncs.count > 64 || (q->syncs.count
+          && (q->syncs.stride != sizeof(struct drm_panthor_sync_op) || !q->syncs.array)))
+      return fail(ENOTSUP);
+   const struct drm_panthor_sync_op *syncs = (const void *)(uintptr_t)q->syncs.array;
+   struct pan_haiku_sync_point waits[64], signals[64];
+   unsigned wait_count = 0, signal_count = 0;
+   for (unsigned i = 0; i < q->syncs.count; i++) {
+      uint32_t type = syncs[i].flags & DRM_PANTHOR_SYNC_OP_HANDLE_TYPE_MASK;
+      if ((syncs[i].flags & ~(DRM_PANTHOR_SYNC_OP_HANDLE_TYPE_MASK | DRM_PANTHOR_SYNC_OP_SIGNAL))
+          || (type != DRM_PANTHOR_SYNC_OP_HANDLE_TYPE_SYNCOBJ
+              && type != DRM_PANTHOR_SYNC_OP_HANDLE_TYPE_TIMELINE_SYNCOBJ)
+          || (type == DRM_PANTHOR_SYNC_OP_HANDLE_TYPE_SYNCOBJ && syncs[i].timeline_value))
+         return fail(EINVAL);
+      struct pan_haiku_sync_point point = { syncs[i].handle, syncs[i].timeline_value };
+      if (syncs[i].flags & DRM_PANTHOR_SYNC_OP_SIGNAL) signals[signal_count++] = point;
+      else waits[wait_count++] = point;
+   }
+   struct haiku_dev *dev = container_of(base, struct haiku_dev, base);
+   simple_mtx_lock(&dev->lock);
+   struct haiku_object *slot = find_object(dev->groups, HAIKU_MAX_GROUPS, req->group_handle);
+   int ret = slot ? pan_haiku_queue_submit(base->fd, slot->handle, 0,
+      q->stream_addr, q->stream_size, waits, wait_count, signals, signal_count, NULL) : fail(EINVAL);
+   simple_mtx_unlock(&dev->lock);
+   return ret;
+}
+
+int haiku_kmod_group_get_state(struct pan_kmod_dev *base, struct drm_panthor_group_get_state *req)
+{
+   if (!req->group_handle || req->pad) return fail(EINVAL);
+   struct pan_haiku_queue_state state;
+   if (pan_haiku_queue_info(base->fd, req->group_handle, &state)) return -1;
+   req->state = (state.state == 1 || state.state == 2) ? 0 : DRM_PANTHOR_GROUP_STATE_FATAL_FAULT;
+   req->fatal_queues = req->state ? 1 : 0;
+   return 0;
+}
+
+int haiku_kmod_group_get_reset_info(struct pan_kmod_dev *base, uint32_t group,
+                                  struct pan_haiku_reset_info *info)
+{
+   return pan_haiku_queue_reset_info(base->fd, group, info);
+}
+
+int haiku_kmod_heap_create(struct pan_kmod_dev *base, struct drm_panthor_tiler_heap_create *req)
+{
+   if (req->handle || req->tiler_heap_ctx_gpu_va || req->first_heap_chunk_gpu_va) return fail(EINVAL);
+   struct haiku_dev *dev = container_of(base, struct haiku_dev, base);
+   simple_mtx_lock(&dev->lock);
+   struct haiku_object *slot = find_object(dev->heaps, HAIKU_MAX_HEAPS, 0);
+   struct pan_haiku_heap heap;
+   int ret = slot ? pan_haiku_heap_create(base->fd, req->vm_id, req->chunk_size,
+      req->initial_chunk_count, req->max_chunks, req->target_in_flight, &heap) : fail(ENOSPC);
+   if (!ret) {
+      *slot = (struct haiku_object) { heap.handle, req->vm_id };
+      req->handle = heap.handle;
+      req->tiler_heap_ctx_gpu_va = heap.context_address;
+      req->first_heap_chunk_gpu_va = heap.first_chunk_address;
+   }
+   simple_mtx_unlock(&dev->lock);
+   return ret;
+}
+int haiku_kmod_heap_destroy(struct pan_kmod_dev *base, struct drm_panthor_tiler_heap_destroy *req)
+{
+   if (!req->handle || req->pad) return fail(EINVAL);
+   struct haiku_dev *dev = container_of(base, struct haiku_dev, base);
+   simple_mtx_lock(&dev->lock);
+   struct haiku_object *slot = find_object(dev->heaps, HAIKU_MAX_HEAPS, req->handle);
+   int ret = slot ? pan_haiku_heap_destroy(base->fd, slot->vm, slot->handle) : fail(EINVAL);
+   if (!ret) memset(slot, 0, sizeof(*slot));
+   simple_mtx_unlock(&dev->lock);
+   return ret;
+}
