+{ return pan_haiku_sync_export(fd, handle, 0, 1, out); }
+static inline int pan_sync_import_snapshot(int fd, uint32_t handle, int snapshot)
+{ return pan_haiku_sync_import_snapshot(fd, handle, 0, snapshot); }
