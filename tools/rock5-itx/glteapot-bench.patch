+// --- rock5 bench instrumentation (scratch build, not the repo GLTeapot) ---
+#include <stdlib.h>
+static bool benchEnabled() { static int v = -1; if (v < 0) v = getenv("TEAPOT_BENCH") != NULL; return v != 0; }
+static bool benchNoSwap() { static int v = -1; if (v < 0) v = getenv("TEAPOT_NO_SWAP") != NULL; return v != 0; }
+static bool benchNoDraw() { static int v = -1; if (v < 0) v = getenv("TEAPOT_NO_DRAW") != NULL; return v != 0; }
+static bool benchFinish() { static int v = -1; if (v < 0) v = getenv("TEAPOT_FINISH") != NULL; return v != 0; }
+static int64 benchFrameLimit() { static int64 v = -1; if (v < 0) { const char* e = getenv("TEAPOT_FRAMES"); v = e ? atoll(e) : 0; } return v; }
+struct BenchStats {
+	int64 frames = 0, windowFrames = 0;
+	bigtime_t start = 0, windowStart = 0;
+	bigtime_t clearUs = 0, drawUs = 0, swapUs = 0, worstFrame = 0;
+};
+static BenchStats sBench;
 #include "GLObject.h"
 #include "ResScroll.h"
 
