SubDir HAIKU_TOP tools rock5-itx ;
UsePrivateSystemHeaders ;

SimpleTest rock5_memory_probe : memory_probe.cpp ;
SimpleTest rock5_ahci_probe : ahci_probe.cpp ;
SimpleTest rock5_mmc_probe : mmc_probe.cpp ;
SimpleTest rock5_nvme_stress : nvme_stress.cpp ;
SimpleTest rock5_nvme_trim_probe : nvme_trim_probe.cpp ;
SimpleTest rock5_pty_write_probe : pty_write_probe.cpp ;
SimpleTest rock5_platform_probe : platform_probe.cpp ;
SimpleTest rock5_asid_probe : asid_probe.cpp ;
UseHeaders [ FDirName $(HAIKU_TOP) src add-ons kernel drivers graphics mali_csf ] ;
SimpleTest rock5_mali_firmware_probe : mali_firmware_probe.cpp CsfFirmware.cpp ;
SimpleTest rock5_mali_resource_probe : mali_resource_probe.cpp ;
SimpleTest rock5_mali_client_probe : mali_client_probe.cpp ;
SEARCH on [ FGristFiles CsfFirmware.cpp ]
	= [ FDirName $(HAIKU_TOP) src add-ons kernel drivers graphics mali_csf ] ;
SimpleTest rock5_cache_probe : cache_probe.cpp ;
UsePrivateHeaders drivers ;
SimpleTest rock5_pci_config_probe : pci_config_probe.cpp ;
SimpleTest rock5_mmc_register_probe : mmc_register_probe.cpp ;
SimpleTest rock5_file_transfer : file_transfer.cpp : network ;
SimpleTest rock5_network_probe : network_probe.cpp : network ;
SimpleTest rock5_memcpy_probe : memcpy_probe.cpp ;
SimpleTest rock5_profile_probe : profile_probe.cpp profile_probe_arm64.S ;

UsePrivateHeaders app net shared storage ;
UseHeaders [ FDirName $(HAIKU_TOP) src servers net ]
	[ FDirName $(HAIKU_TOP) headers os add-ons network_settings ] : true ;
SimpleTest rock5_services_probe : services_probe.cpp Services.cpp
	: be network bnetapi [ TargetLibstdc++ ] shared ;
SEARCH on [ FGristFiles Services.cpp ]
	= [ FDirName $(HAIKU_TOP) src servers net ] ;
LINKFLAGS on rock5_services_probe += -Wl,--wrap=pipe -Wl,--wrap=select ;

