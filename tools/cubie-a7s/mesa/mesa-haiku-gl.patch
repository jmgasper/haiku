diff -ruN a/src/c11/impl/threads_posix.c b/src/c11/impl/threads_posix.c
--- a/src/c11/impl/threads_posix.c
+++ b/src/c11/impl/threads_posix.c
@@ -35,11 +35,35 @@
     void *arg;
 };
 
+#ifdef __HAIKU__
+/* Haiku's runtime loader starts a thread's dynamic thread vector at
+ * generation 0. Once any library with thread-local storage has been
+ * unloaded in the process, the thread's second TLS access frees and
+ * re-creates the blocks of every library loaded since, and what the first
+ * access wrote is lost. In Summit's WebProcess, zink's cache thread wrote
+ * util_call_once_data()'s context; the call_once() callback then read it
+ * back as NULL and called it. Two accesses before the thread runs anything
+ * bring its vector up to date. Each call is one __tls_get_addr(), which
+ * updates the whole vector, not just this library's block.
+ */
+static __thread volatile int impl_thrd_tls_primer;
+
+static void __attribute__((noinline, noclone))
+impl_thrd_touch_tls(void)
+{
+    impl_thrd_tls_primer++;
+}
+#endif
+
 static void *
 impl_thrd_routine(void *p)
 {
     struct impl_thrd_param pack = *((struct impl_thrd_param *)p);
     free(p);
+#ifdef __HAIKU__
+    impl_thrd_touch_tls();
+    impl_thrd_touch_tls();
+#endif
     return (void*)(intptr_t)pack.func(pack.arg);
 }
 
@@ -252,6 +276,29 @@
     if (!pack) return thrd_nomem;
     pack->func = func;
     pack->arg = arg;
+#ifdef __HAIKU__
+    {
+        /* Haiku gives a thread 256 KiB of stack, Linux 8 MiB, and Mesa's
+         * code is written for the latter: zink's flush thread overflowed in
+         * the PowerVR driver's transfer submission. Every thread Mesa makes
+         * (util_queue, u_thread_create(), the Vulkan runtime's submit
+         * thread) comes through here. */
+        pthread_attr_t attr;
+        int err;
+        if (pthread_attr_init(&attr) != 0) {
+            free(pack);
+            return thrd_error;
+        }
+        pthread_attr_setstacksize(&attr, 8 * 1024 * 1024);
+        err = pthread_create(thr, &attr, impl_thrd_routine, pack);
+        pthread_attr_destroy(&attr);
+        if (err != 0) {
+            free(pack);
+            return thrd_error;
+        }
+        return thrd_success;
+    }
+#endif
     if (pthread_create(thr, NULL, impl_thrd_routine, pack) != 0) {
