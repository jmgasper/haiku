+   struct drm_syncobj_handle request;
+
+   memset(&request, 0, sizeof(request));
+   request.fd = obj_fd;
+   if (drmIoctl(fd, DRM_IOCTL_SYNCOBJ_FD_TO_HANDLE, &request) != 0)
+      return -1;
+
+   *handle = request.handle;
+   return 0;
+#else
+   (void)fd; (void)obj_fd; (void)handle;
+   return haiku_pvr_unsupported();
+#endif
