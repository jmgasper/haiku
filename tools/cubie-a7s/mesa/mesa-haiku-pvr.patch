+                       VK_ERROR_UNKNOWN,
+                       "no area at %p (%s)",
+                       map,
+                       strerror(area));
+   }
+
+   status = delete_area(area);
+   if (status != B_OK) {
+      return vk_errorf(NULL,
+                       VK_ERROR_UNKNOWN,
+                       "delete_area failed (%s)",
+                       strerror(status));
