diff -ruN a/src/util/u_sync_provider_haiku.c b/src/util/u_sync_provider_haiku.c
--- a/src/util/u_sync_provider_haiku.c
+++ b/src/util/u_sync_provider_haiku.c
@@ -0,0 +1,197 @@
+/*
+ * Copyright 2026 air/OS
+ * SPDX-License-Identifier: MIT
+ */
+
+/* DRM sync objects on air/OS (Haiku), for the PowerVR render device
+ * (/dev/graphics/powervr/0).
+ *
+ * The kernel driver implements Linux's syncobj ioctls with Linux's
+ * structures behind the op codes of pvr_haiku.h (PVR_HAIKU_NR_SYNCOBJ_*):
+ * binary and timeline sync objects, WAIT_ALL / WAIT_FOR_SUBMIT /
+ * WAIT_AVAILABLE, reset, signal, timeline signal and wait, query and
+ * transfer between points. include/xf86drm.h (the libdrm stand-in) carries
+ * each request; this is the provider Mesa's Vulkan runtime reaches them
+ * through (vk_drm_syncobj.c, vk_device_set_drm_fd()).
+ *
+ * Timelines are offered when the kernel answers DRM_CAP_SYNCOBJ_TIMELINE.
+ * There are no file descriptors for sync objects or sync files yet: those
+ * entries fail with EOPNOTSUPP (see xf86drm.h).
+ *
+ * Every entry returns 0 or -1 with errno set; a timed out wait has errno
+ * ETIME, which is what vk_drm_syncobj.c looks for.
+ */
+
+#include "u_sync_provider.h"
+
+#include <errno.h>
+#include <stdlib.h>
+
+#include <xf86drm.h>
+
+struct haiku_sync_provider {
+   struct util_sync_provider base;
+   int fd;
+};
+
+static int
+haiku_fd(struct util_sync_provider *p)
+{
+   return ((struct haiku_sync_provider *)p)->fd;
+}
+
+/* PVR_HAIKU_NR_SYNCOBJ_CREATE; flags: DRM_SYNCOBJ_CREATE_SIGNALED */
+static int
+haiku_create(struct util_sync_provider *p, uint32_t flags, uint32_t *handle)
+{
+   return drmSyncobjCreate(haiku_fd(p), flags, handle);
+}
+
+/* PVR_HAIKU_NR_SYNCOBJ_DESTROY */
+static int
+haiku_destroy(struct util_sync_provider *p, uint32_t handle)
+{
+   return drmSyncobjDestroy(haiku_fd(p), handle);
+}
+
+static int
+haiku_handle_to_fd(struct util_sync_provider *p, uint32_t handle,
+                   int *out_obj_fd)
+{
+   return drmSyncobjHandleToFD(haiku_fd(p), handle, out_obj_fd);
+}
+
+static int
+haiku_fd_to_handle(struct util_sync_provider *p, int obj_fd,
+                   uint32_t *handle)
+{
+   return drmSyncobjFDToHandle(haiku_fd(p), obj_fd, handle);
+}
+
+static int
+haiku_import_sync_file(struct util_sync_provider *p, uint32_t handle,
+                       int sync_file_fd)
+{
+   return drmSyncobjImportSyncFile(haiku_fd(p), handle, sync_file_fd);
+}
+
+static int
+haiku_export_sync_file(struct util_sync_provider *p, uint32_t handle,
+                       int *out_sync_file_fd)
+{
+   return drmSyncobjExportSyncFile(haiku_fd(p), handle, out_sync_file_fd);
+}
+
+/* PVR_HAIKU_NR_SYNCOBJ_WAIT; timeout_nsec is absolute (CLOCK_MONOTONIC);
+ * flags: DRM_SYNCOBJ_WAIT_FLAGS_WAIT_ALL, _WAIT_FOR_SUBMIT */
+static int
+haiku_wait(struct util_sync_provider *p, uint32_t *handles,
+           unsigned num_handles, int64_t timeout_nsec, unsigned flags,
+           uint32_t *first_signaled)
+{
+   return drmSyncobjWait(haiku_fd(p), handles, num_handles, timeout_nsec,
+                         flags, first_signaled);
+}
+
+/* PVR_HAIKU_NR_SYNCOBJ_RESET */
+static int
+haiku_reset(struct util_sync_provider *p, const uint32_t *handles,
+            uint32_t handle_count)
+{
+   return drmSyncobjReset(haiku_fd(p), handles, handle_count);
+}
+
+/* PVR_HAIKU_NR_SYNCOBJ_SIGNAL */
+static int
+haiku_signal(struct util_sync_provider *p, const uint32_t *handles,
+             uint32_t handle_count)
+{
+   return drmSyncobjSignal(haiku_fd(p), handles, handle_count);
+}
+
+/* PVR_HAIKU_NR_SYNCOBJ_TIMELINE_SIGNAL */
+static int
+haiku_timeline_signal(struct util_sync_provider *p, const uint32_t *handles,
+                      uint64_t *points, uint32_t handle_count)
+{
+   return drmSyncobjTimelineSignal(haiku_fd(p), handles, points,
+                                   handle_count);
+}
+
+/* PVR_HAIKU_NR_SYNCOBJ_TIMELINE_WAIT; flags as haiku_wait() plus
+ * DRM_SYNCOBJ_WAIT_FLAGS_WAIT_AVAILABLE (vkWaitSemaphores for "pending",
+ * and the runtime's wait-before-signal check) */
+static int
+haiku_timeline_wait(struct util_sync_provider *p, uint32_t *handles,
+                    uint64_t *points, unsigned num_handles,
+                    int64_t timeout_nsec, unsigned flags,
+                    uint32_t *first_signaled)
+{
+   return drmSyncobjTimelineWait(haiku_fd(p), handles, points, num_handles,
+                                 timeout_nsec, flags, first_signaled);
+}
+
+/* PVR_HAIKU_NR_SYNCOBJ_QUERY; flags: DRM_SYNCOBJ_QUERY_FLAGS_LAST_SUBMITTED */
+static int
+haiku_query(struct util_sync_provider *p, uint32_t *handles, uint64_t *points,
+            uint32_t handle_count, uint32_t flags)
+{
+   return drmSyncobjQuery2(haiku_fd(p), handles, points, handle_count, flags);
+}
+
+/* PVR_HAIKU_NR_SYNCOBJ_TRANSFER */
+static int
+haiku_transfer(struct util_sync_provider *p, uint32_t dst_handle,
+               uint64_t dst_point, uint32_t src_handle, uint64_t src_point,
+               uint32_t flags)
+{
+   return drmSyncobjTransfer(haiku_fd(p), dst_handle, dst_point, src_handle,
+                             src_point, flags);
+}
+
+static void
+haiku_finalize(struct util_sync_provider *p)
+{
+   free(p);
+}
+
+static struct util_sync_provider *
+haiku_clone(struct util_sync_provider *p)
+{
+   return util_sync_provider_drm(haiku_fd(p));
+}
+
+struct util_sync_provider *
+util_sync_provider_drm(int drm_fd)
+{
+   struct haiku_sync_provider *provider = calloc(1, sizeof(*provider));
+   if (provider == NULL)
+      return NULL;
+
+   provider->fd = drm_fd;
+   provider->base = (struct util_sync_provider) {
+      .create = haiku_create,
+      .destroy = haiku_destroy,
+      .handle_to_fd = haiku_handle_to_fd,
+      .fd_to_handle = haiku_fd_to_handle,
+      .import_sync_file = haiku_import_sync_file,
+      .export_sync_file = haiku_export_sync_file,
+      .wait = haiku_wait,
+      .reset = haiku_reset,
+      .signal = haiku_signal,
+      .query = haiku_query,
+      .transfer = haiku_transfer,
+      .finalize = haiku_finalize,
+      .clone = haiku_clone,
+   };
+
+   /* PVR_HAIKU_NR_GET_CAP */
+   uint64_t timelines = 0;
+   if (drmGetCap(drm_fd, DRM_CAP_SYNCOBJ_TIMELINE, &timelines) == 0 &&
+       timelines != 0) {
+      provider->base.timeline_signal = haiku_timeline_signal;
+      provider->base.timeline_wait = haiku_timeline_wait;
+   }
+
+   return &provider->base;
+}
