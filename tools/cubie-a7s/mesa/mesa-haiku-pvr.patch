+/* (air/OS) The VkResult for a failed winsys request whose errno is "err".
+ * EIO means the kernel ended the context (a GPU reset, a context marked
+ * faulty) and ENODEV that the device is gone: both are VK_ERROR_DEVICE_LOST,
+ * so the runtime and zink stop waiting for work that will never run. Every
+ * other failure stays VK_ERROR_OUT_OF_DEVICE_MEMORY, as with pvrsrv.
+ */
+static inline VkResult
+pvr_drm_job_error(int err, const char *what)
+{
+   if (err == EIO || err == ENODEV) {
+      return vk_errorf(NULL,
+                       VK_ERROR_DEVICE_LOST,
+                       "%s: the kernel ended the context (errno %d: %s)",
+                       what,
+                       err,
+                       strerror(err));
+   }
+
+   return vk_errorf(NULL,
+                    VK_ERROR_OUT_OF_DEVICE_MEMORY,
+                    "%s (errno %d: %s)",
+                    what,
+                    err,
+                    strerror(err));
+}
+
+static inline VkResult
+pvr_drm_submit_jobs(int fd,
+                    struct drm_pvr_ioctl_submit_jobs_args *args,
+                    const char *what)
+{
+   if (drmIoctl(fd, DRM_IOCTL_PVR_SUBMIT_JOBS, args) == 0)
+      return VK_SUCCESS;
+
+   return pvr_drm_job_error(errno, what);
+}
 
