# air/OS for the Radxa Cubie A7S (Allwinner A733, arm64). Include this file
# from the build directory's UserBuildConfig.
#
#	jam -q @minimum-cubie		the small bring-up image (haiku-cubie-minimum.image)
#
# The image is a bare BFS volume; tools/cubie-a7s/build-lab-image.sh puts it
# on the lab card, with the EFI loader on the ESP.

HAIKU_IMAGE_LABEL = airOS ;

if $(HAIKU_BUILD_PROFILE) = minimum-cubie {
	HAIKU_IMAGE_SIZE = 900 ;
}
DefineBuildProfile minimum-cubie : image : "haiku-cubie-minimum.image" ;

# The lab overlay: files that only make sense on the lab's board. It is
# switched on by the presence of /mnt/HaikuWork/cubie/state/lab-image.
# Set CUBIE_LAB_IMAGE = 0 before including this file for distributable images.
CUBIE_LAB_IMAGE ?= auto ;
if $(CUBIE_LAB_IMAGE) = auto {
	CUBIE_LAB_IMAGE = ;
	if [ Glob /mnt/HaikuWork/cubie/state : lab-image ] {
		CUBIE_LAB_IMAGE = 1 ;
	}
}

rule UserBuildConfigRulePreImage
{
	if $(CUBIE_LAB_IMAGE) = 1 {
		# A telnet login for the lab, with an account whose password hash
		# lives outside the tree (state/lab-overlay, made once per lab).
		local overlay = /mnt/HaikuWork/cubie/state/lab-overlay ;
		if [ Glob $(overlay) : shadow ] {
			local shadow = <cubie-lab>shadow ;
			SEARCH on $(shadow) = $(overlay) ;
			AddFilesToHaikuImage system settings etc : $(shadow) ;
			local services = <cubie-lab>services ;
			SEARCH on $(services) = $(overlay) ;
			AddFilesToHaikuImage system settings network : $(services) ;
		}
	}
}
